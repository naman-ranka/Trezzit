---
import { ClientRouter } from 'astro:transitions';
import BaseSeo from '../components/BaseSeo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <BaseSeo title={title} description={description} ogImage={ogImage} canonical={canonical} />
    <ClientRouter />
  </head>
  <body class="bg-slate-900 font-sans text-slate-50 antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/scrollAnimations.ts';
    </script>
  </body>
</html>
