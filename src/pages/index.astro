---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import McpConversationPreview from '../components/preview/McpConversationPreview.astro';
import ReceiptHeroPreview from '../components/preview/ReceiptHeroPreview.astro';
import BalanceMatrixPreview from '../components/preview/BalanceMatrixPreview.astro';
import ScopeMatrixPreview from '../components/preview/ScopeMatrixPreview.astro';
import ReceiptScanAnimation from '../components/ReceiptScanAnimation.astro';
import SplitTableAnimation from '../components/SplitTableAnimation.astro';

const meta = {
  title: 'Trezzit - AI-native itemized expense ledger',
  description: 'Ask AI clients where your money went with Trezzit MCP tools, itemized bill records, receipt upload, scoped writes, and public demos.',
  canonical: '/',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Trezzit',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
};
---

<Base meta={meta}>
  <Hero
    title="Ask your AI where your money went."
    description="Trezzit is an itemized expense ledger with an MCP server. Agents can search bills, read balances, inspect item shares, upload receipts, and create scoped bill records over OAuth 2.1."
    primaryLabel="Explore AI tools"
    primaryHref="/ai"
    secondaryLabel="Try receipt demo"
    secondaryHref="https://app.trezzit.com/try-receipt"
  />

  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Real inventory</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">A real tool inventory, not a chat veneer.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">`tools/list` returns 13 tools. `get_expenses` answers from item shares. `create_bill`, `create_settlement`, and `delete_bill` are scoped write tools with attribution instead of generic chat actions.</p>
      </div>
      <div class="fade-up"><McpConversationPreview /></div>
    </div>
  </section>

  <section class="section-pad border-y border-white/10 bg-[#060713]">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Under the agent</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">The app writes the ledger first.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">A bill becomes `BillItem` rows and one `ItemShare` row per person. That is why a group receipt can become your coffee, your share of tax, your category, and your answer inside an AI client.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <div class="fade-up"><ReceiptHeroPreview /></div>
        <div class="fade-up md:pt-12"><BalanceMatrixPreview /></div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Write safety</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Write tools need guardrails.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">OAuth scopes separate reads from mutations. MCP writes are logged through `AIAction`, attributed to the AI client, rate-limited at 60/min and 600/hr per OAuth session, and deletable through MCP only inside the 30-minute AI-created bill window.</p>
      </div>
      <div class="fade-up"><ScopeMatrixPreview /></div>
    </div>
  </section>

  <section class="section-pad border-y border-white/10 bg-[#060713]">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Receipt AI</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Scan, review, then save structured records.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">Receipt scanning extracts items, prices, tax, and tip into a reviewable bill. The marketing page stays dark, but the product surface stays light because that is what the shipped app uses.</p>
      </div>
      <div class="fade-up"><ReceiptScanAnimation /></div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Splits and import</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Split and import, concretely.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">Trezzit supports equal, percentage, exact, shares, and adjusted split methods per item. Splitwise CSV import follows Upload, Group, You, Map, Done, then verifies balances within one cent before committing.</p>
      </div>
      <div class="fade-up"><SplitTableAnimation /></div>
    </div>
  </section>

  <section class="section-pad border-t border-white/10 bg-[#060713]">
    <div class="container-page rounded-lg border border-brand-500/35 bg-brand-500/10 p-8 md:p-10">
      <p class="eyebrow">Pricing</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Free while the product matures.</h2>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">Free, forever (for now). There is no paid Pro plan, no Stripe integration, and no per-tier scan quota today.</p>
      <a class="btn-primary mt-8" href="/pricing">Read pricing boundary</a>
    </div>
  </section>
</Base>
