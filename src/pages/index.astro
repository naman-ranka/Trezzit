---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import TryBeforeSignup from '../components/sections/TryBeforeSignup.astro';
import ScanPaperMess from '../components/sections/ScanPaperMess.astro';
import TapWhoHadWhat from '../components/sections/TapWhoHadWhat.astro';
import FriendsJoinLater from '../components/sections/FriendsJoinLater.astro';
import MoveFromSplitwise from '../components/sections/MoveFromSplitwise.astro';
import AskAI from '../components/sections/AskAI.astro';
import StartFree from '../components/sections/StartFree.astro';
---

<Base
  title="Trezzit - Split Receipts Without the Group Chat Mess"
  description="Scan receipts, split items with friends, invite people by link or QR, and try Trezzit's demos before signing up."
>
  <main>
    <Hero />
    <TryBeforeSignup />
    <ScanPaperMess />
    <TapWhoHadWhat />
    <FriendsJoinLater />
    <MoveFromSplitwise />
    <AskAI />
    <StartFree />
  </main>
</Base>
