---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import LedgerTable from '../components/LedgerTable.astro';
import SplitTableAnimation from '../components/SplitTableAnimation.astro';
import ReceiptScanAnimation from '../components/ReceiptScanAnimation.astro';

const meta = {
  title: 'Trezzit - Itemized Expense Ledger',
  description: 'Trezzit stores shared expenses as BillItem and ItemShare rows, so splitting, categories, budgeting, imports, and AI answers use item-level truth.',
  canonical: '/',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Trezzit',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
};

const mcpExample = `{
  "jsonrpc": "2.0",
  "method": "tools/call",
  "params": {
    "name": "get_expenses",
    "arguments": { "category": "Food", "group_id": "household" }
  },
  "id": 42
}`;
---

<Base meta={meta}>
  <Hero />

  <Section
    eyebrow="One model"
    title="One data model, four product surfaces."
    body="Splitting, categories, budgeting, and AI queries all point back to the same atomic row: the item share. The product can stay precise because it does not translate between a splitter model and a finance model."
  >
    <div class="mt-10 grid gap-4 md:grid-cols-4">
      {['Split by item', 'Categorize by item', 'Budget by your share', 'Ask AI by item'].map((item) => (
        <div class="rounded-xl border border-slate-800 bg-slate-950 p-5">
          <p class="font-mono text-sm text-brand-100">ItemShare</p>
          <h3 class="mt-3 text-xl font-semibold text-white">{item}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-400">The surface changes. The source row does not.</p>
        </div>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="Proof"
    title="The ledger table."
    body="The pitch is not that Trezzit has a database. The pitch is that every product answer comes from rows small enough to represent what each person actually consumed."
    className="bg-slate-950/50"
  >
    <LedgerTable />
  </Section>

  <Section
    eyebrow="Split engine"
    title="Splitting is per item, not per bill."
    body="One receipt can mix EQUAL, PERCENTAGE, EXACT, SHARES, and ADJUSTED methods. The split type lives on the ItemShare row, so a latte can be exact while the shared pizza is percentage-based."
  >
    <SplitTableAnimation />
  </Section>

  <Section
    eyebrow="Personal finance"
    title="Personal expenses without lying."
    body="A normal transaction tracker sees the whole group receipt. Trezzit can report only your ItemShare.share_amount rows, with your categories and tags attached to those shares."
    className="bg-slate-950/50"
  >
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-6">
        <p class="text-sm uppercase text-slate-500">Transaction tracker</p>
        <p class="mt-4 text-4xl font-semibold text-white">$84.12</p>
        <p class="mt-2 text-slate-400">One grocery receipt, treated as one personal expense.</p>
      </div>
      <div class="rounded-xl border border-brand-500/40 bg-brand-500/10 p-6">
        <p class="text-sm uppercase text-brand-100">Trezzit ledger</p>
        <p class="mt-4 text-4xl font-semibold text-white">$26.40</p>
        <p class="mt-2 text-slate-300">Only your shares, grouped by item-level categories.</p>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Receipt AI"
    title="Receipt AI with validation."
    body="Receipt scanning is useful only when it lands in the ledger cleanly. Trezzit extracts line items, checks that item prices reconcile to the total, then keeps the review step explicit."
  >
    <ReceiptScanAnimation />
  </Section>

  <Section
    eyebrow="MCP"
    title="MCP for the ledger."
    body="An AI agent can call get_expenses and explain which item shares matched, rather than guessing from whole transaction names."
    className="bg-slate-950/50"
  >
    <pre class="mt-10 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 p-5 text-sm text-slate-200"><code>{mcpExample}</code></pre>
  </Section>

  <Section
    eyebrow="Migration"
    title="Migration and groups."
    body="Splitwise CSV import is a guided flow: Upload, Group, You, Map, Done. Groups lock currency at creation, so Trezzit does exact group math instead of exchange-rate guesses."
  />

  <Section
    eyebrow="Pricing"
    title="Free now."
    body="Free, forever (for now). Premium features arrive when we ship payments."
    className="bg-slate-950/50"
  >
    <a class="mt-8 inline-flex rounded-full bg-brand-500 px-6 py-3 font-medium text-white hover:bg-brand-600" href="https://app.trezzit.com/try-receipt">Try the receipt scanner</a>
  </Section>
</Base>
