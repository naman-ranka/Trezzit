---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return [{ params: { slug: '2026-05-21-landing-redesign' } }];
}

const meta = {
  title: 'Landing page redesign - Trezzit Changelog',
  description: 'Trezzit landing redesign entry covering the multi-page Astro site, flagship MCP/AI page, and honest pricing boundary.',
  canonical: '/changelog/2026-05-21-landing-redesign',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Landing page redesign',
    datePublished: '2026-05-21',
  },
};
---

<Base meta={meta}>
  <article class="section-pad">
    <div class="container-page max-w-3xl">
      <a href="/changelog" class="text-sm font-medium text-brand-300">Back to changelog</a>
      <p class="eyebrow mt-8">May 21, 2026</p>
      <h1 class="mt-5 text-5xl font-bold tracking-tight md:text-6xl">Landing page redesign</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-300">Multi-page Astro site, MCP/AI page as flagship, and honest pricing.</p>
      <div class="mt-10 space-y-8 text-slate-300">
        <section>
          <h2 class="text-2xl font-semibold text-white">Shipped</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5">
            <li>Multi-page Astro scaffold for the Trezzit marketing site.</li>
            <li>MCP and AI page promoted to the flagship route.</li>
            <li>Honest pricing copy: free, forever for now, with paid tiers not available today.</li>
          </ul>
        </section>
        <section>
          <h2 class="text-2xl font-semibold text-white">Technical notes</h2>
          <p class="mt-4">The site is structured around Astro pages, shared layout components, MDX changelog entries, sitemap generation, Tailwind, and Vercel static output.</p>
        </section>
      </div>
    </div>
  </article>
</Base>
