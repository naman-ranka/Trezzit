---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('changelog');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — Trezzit Changelog`} description={entry.data.summary}>
  <article class="bg-slate-950 px-4 py-16 sm:px-6 lg:px-8">
    <div class="prose prose-invert prose-slate mx-auto max-w-3xl">
      <p class="font-mono text-sm text-brand-300">{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <Content />
    </div>
  </article>
</Base>
