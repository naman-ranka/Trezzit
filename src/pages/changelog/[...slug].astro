---
import Base from '../../layouts/Base.astro';
import Entry from '../../content/changelog/2026-05-21-redesign.mdx';

export function getStaticPaths() {
  return [{ params: { slug: '2026-05-21-redesign' } }];
}

const entry = {
  title: 'Phase 4 ledger-first landing polish',
  date: new Date('2026-05-21'),
  summary: 'Replaced the scaffold with the Direction A landing: ledger-first hero, receipt and split demos, import and placeholder fragments, MCP inventory, and honest pricing.',
};
---

<Base title={`${entry.title} - Trezzit Changelog`} description={entry.summary}>
  <article class="bg-slate-950 py-16 md:py-24">
    <div class="section-shell max-w-3xl">
      <a href="/changelog" class="text-sm font-semibold text-brand-300 hover:text-brand-200">Back to changelog</a>
      <p class="mt-8 text-sm text-slate-500">{entry.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-50 md:text-6xl">{entry.title}</h1>
      <div class="prose prose-invert prose-slate mt-10 max-w-none">
        <Entry />
      </div>
    </div>
  </article>
</Base>
