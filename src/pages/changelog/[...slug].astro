---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('changelog');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} - Trezzit Changelog`}
  description={entry.data.summary}
  canonical={new URL(`/changelog/${entry.slug}`, Astro.site ?? 'https://trezzit.com').toString()}
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/changelog" class="text-sm text-brand-300 hover:text-brand-100">Back to changelog</a>
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-400">
      <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
      {entry.data.tags.map((tag) => <span class="rounded-full bg-brand-500/10 px-2 py-1 text-brand-100">{tag}</span>)}
    </div>
    <h1 class="mt-4 text-4xl font-bold text-white">{entry.data.title}</h1>
    <p class="mt-4 text-lg text-slate-300">{entry.data.summary}</p>
    <article class="prose prose-invert mt-10 max-w-none prose-a:text-brand-300">
      <Content />
    </article>
  </main>
</Base>
