---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';

const entries = (await getCollection('changelog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const meta = {
  title: 'Trezzit Changelog - Product Updates',
  description: 'Follow Trezzit product updates across ledger, AI, import, groups, personal expenses, auth, and marketing site releases.',
  canonical: '/changelog',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Trezzit Changelog',
  },
};
---

<Base meta={meta}>
  <Section eyebrow="Changelog" title="Product updates, reverse chronological." body="The changelog is file-backed MDX, so future releases can be added without editing the page shell." />
  <section class="px-6 pb-24">
    <div class="mx-auto max-w-3xl space-y-5">
      {entries.map((entry) => (
        <article class="rounded-xl border border-slate-800 bg-slate-950 p-6">
          <p class="font-mono text-sm text-slate-500">{entry.data.date.toISOString().slice(0, 10)} / {entry.data.area}</p>
          <h2 class="mt-3 text-2xl font-semibold text-white">{entry.data.title}</h2>
          <p class="mt-3 text-slate-300">{entry.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
