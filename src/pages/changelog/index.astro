---
import Base from '../../layouts/Base.astro';

const meta = {
  title: 'Trezzit Changelog - product and MCP updates',
  description: 'Track Trezzit updates for the marketing site, MCP server, receipt flows, demos, and itemized expense product work.',
  canonical: '/changelog',
  schema: { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Trezzit changelog' },
};

const entries = [
  {
    title: 'Landing page redesign',
    date: 'May 21, 2026',
    href: '/changelog/2026-05-21-landing-redesign',
    summary: 'Multi-page Astro site, MCP/AI page as flagship, and honest pricing.',
    tags: ['landing', 'mcp', 'pricing'],
  },
];
---

<Base meta={meta}>
  <section class="section-pad">
    <div class="container-page">
      <p class="eyebrow">Changelog</p>
      <h1 class="mt-5 text-4xl font-medium tracking-[-0.03em] md:text-6xl">Product updates, in files.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">Trezzit release notes are sourced from MDX entries so protocol changes, product updates, and pricing boundaries stay easy to audit.</p>
      <div class="mt-12 grid gap-4">
        {entries.map((entry) => (
          <a href={entry.href} class="surface hover-card block p-6 fade-up">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
              <time>{entry.date}</time>
              {entry.tags.map((tag) => <span class="rounded-full bg-white/5 px-3 py-1">{tag}</span>)}
            </div>
            <h2 class="mt-4 text-2xl font-semibold tracking-[-0.02em]">{entry.title}</h2>
            <p class="mt-3 text-slate-300">{entry.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
