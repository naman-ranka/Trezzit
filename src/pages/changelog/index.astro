---
import Base from '../../layouts/Base.astro';

const entries = [
  {
    slug: '2026-05-21-redesign',
    title: 'Phase 4 ledger-first landing polish',
    date: new Date('2026-05-21'),
    summary: 'Replaced the scaffold with the Direction A landing: ledger-first hero, receipt and split demos, import and placeholder fragments, MCP inventory, and honest pricing.',
  },
];
const groups: Record<string, typeof entries> = {};
for (const entry of entries) {
  const month = entry.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  groups[month] = [...(groups[month] || []), entry];
}
---

<Base
  title="Trezzit Changelog - Product Updates"
  description="Follow Trezzit releases across itemized splitting, receipt scanning, imports, AI, and group expense workflows."
>
  <section class="bg-slate-950 py-16 md:py-24">
    <div class="section-shell">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Changelog</p>
          <h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-50 md:text-7xl">Product updates</h1>
        </div>
        <a href="/rss.xml" class="rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-sm font-semibold text-brand-300">RSS</a>
      </div>
      <div class="mt-12 space-y-10">
        {Object.entries(groups).map(([month, monthEntries]) => (
          <div class="grid gap-5 md:grid-cols-[150px_1fr]">
            <div class="text-sm font-semibold uppercase tracking-wider text-slate-500 md:sticky md:top-24 md:self-start">{month}</div>
            <div class="space-y-4">
              {monthEntries.map((entry, index) => (
                <article class={`rounded-2xl border border-slate-800 bg-slate-900/70 p-6 ${index === 0 ? 'shadow-lg shadow-indigo-500/10' : ''}`}>
                  <p class="text-sm text-slate-500">{entry.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
                  <h2 class="mt-2 text-xl font-semibold text-slate-50">{entry.title}</h2>
                  <p class="mt-3 line-clamp-2 text-slate-400">{entry.summary}</p>
                  <a href={`/changelog/${entry.slug}`} class="mt-4 inline-flex text-sm font-semibold text-brand-300 hover:text-brand-200">Read more</a>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
