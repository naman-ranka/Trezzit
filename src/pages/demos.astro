---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

const meta = {
  title: 'Trezzit Demos - receipt scan and bill creation',
  description: 'Try Trezzit public demos: the polished receipt demo, the legacy bill calculator, and the V2 bill creation demo before connecting MCP clients.',
  canonical: '/demos',
  schema: { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Trezzit demos' },
};

const demos = [
  ['Receipt demo', 'Scan a sample receipt and watch your share auto-track.', 'https://app.trezzit.com/try-receipt', 'Headline demo'],
  ['Legacy bill calculator', 'A secondary public calculator. It is useful, but lower polish than the receipt demo.', 'https://app.trezzit.com/demo', 'Legacy'],
  ['V2 bill creation demo', 'Try the newer bill creation flow with a standalone demo surface.', 'https://app.trezzit.com/demo/v2', 'V2'],
];
---

<Base meta={meta}>
  <Hero
    eyebrow="Demos"
    title="See the data shape before wiring an AI client."
    description="Trezzit keeps public demos available because MCP users should be able to inspect how receipt items, shares, and bill creation feel before connecting tools."
    primaryLabel="Try receipt demo"
    primaryHref="https://app.trezzit.com/try-receipt"
    secondaryLabel="Explore AI tools"
    secondaryHref="/ai"
  />
  <section class="section-pad">
    <div class="container-page grid gap-5 md:grid-cols-3">
      {demos.map(([title, body, href, label]) => (
        <a class="surface hover-card block p-6 fade-up" href={href}>
          <span class="rounded-full bg-brand-500/15 px-3 py-1 font-mono text-xs uppercase tracking-widest text-brand-300">{label}</span>
          <h2 class="mt-5 text-2xl font-semibold tracking-[-0.02em]">{title}</h2>
          <p class="mt-3 leading-relaxed text-slate-300">{body}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="section-pad border-t border-white/10 bg-[#060713]">
    <div class="container-page max-w-4xl fade-up">
      <p class="eyebrow">Why demos matter</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">AI users need proof, not screenshots of chat.</h2>
      <p class="mt-5 text-lg leading-relaxed text-slate-300">The receipt demo shows the key Trezzit primitive: a bill turns into structured items, and each person gets their own item-share rows. That is the same shape the MCP server reads when an agent answers expense questions.</p>
    </div>
  </section>
</Base>
