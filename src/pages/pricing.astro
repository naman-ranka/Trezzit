---
import Base from '../layouts/Base.astro';

const faqs = [
  ['Will this stay free?', 'Trezzit is free while the product grows. Premium features arrive once payments ship; there is no paid plan to buy today.'],
  ['Are receipt scans limited?', 'There are no shipped paid quotas today. The product does cache repeat receipt uploads by SHA-256 hash.'],
  ['Do friends need accounts?', 'No. You can add placeholders first, then invite friends later by QR or magic link.'],
];
---

<Base
  title="Trezzit Pricing — Free, Forever for Now"
  description="Trezzit is free while payments and premium tiers are not yet shipped. No fake quotas, no surprise Pro wall."
>
  <section class="bg-slate-950 px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-sm text-brand-300">Pricing</p>
      <h1 class="mt-4 text-4xl font-bold text-white md:text-6xl">Free, forever — for now.</h1>
      <p class="mt-6 text-xl text-slate-300">Premium features arrive once we ship payments. No credit card. No quotas. No surprise Pro wall.</p>
      <div class="mt-10 rounded-xl border border-brand-300/30 bg-slate-900 p-8">
        <h2 class="text-2xl font-semibold text-white">$0 today</h2>
        <p class="mt-3 text-slate-300">Itemized splitting, groups, placeholders, public demos, receipt scanning for signed-in users, Splitwise CSV import, and MCP access within platform rate limits.</p>
        <a href="https://app.trezzit.com/signup" class="mt-6 inline-flex rounded-lg bg-brand-500 px-5 py-3 font-medium text-white hover:bg-brand-400">Sign up free</a>
      </div>
    </div>
  </section>
  <section class="bg-slate-900 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-4xl gap-4">
      {faqs.map(([question, answer]) => (
        <article class="rounded-xl border border-white/10 bg-slate-950 p-6">
          <h2 class="text-lg font-semibold text-white">{question}</h2>
          <p class="mt-2 text-slate-300">{answer}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
