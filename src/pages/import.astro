---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const meta = {
  title: 'Splitwise CSV Import for Trezzit',
  description: 'Move from Splitwise to Trezzit with CSV import, name mapping, placeholder members, settlement-aware rows, and balance verification within one cent.',
  canonical: '/import',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'From Splitwise to Trezzit',
  },
};

const steps = [
  ['Upload', 'Drop in a Splitwise CSV export with Date, Description, Category, Cost, Currency, and per-person columns.'],
  ['Group', 'Create a new Trezzit group or choose the destination group for the imported ledger.'],
  ['You', 'Trezzit suggests the likely current user by checking "You", full name, then first name.'],
  ['Map', 'Match CSV people to Trezzit people, or create placeholder members for names not in the group yet.'],
  ['Done', 'Review the result, invite placeholders, and keep the imported balances only if verification passes.'],
];

const claims = [
  ['Recognizes Splitwise CSV exports', 'Trezzit handles Splitwise export headers and Splitwise-specific rows like Total balance and Settle all balances.'],
  ['Auto-detects who you are', 'The You step tries literal "You", then full name, then first name, and shows a likely-you suggestion.'],
  ['Unknown names become invitable placeholders', 'New CSV names can become placeholder members, with invite links generated after import.'],
  ['Balance-verified, all-or-nothing imports', 'After bill creation, Trezzit recomputes balances and rolls back if they miss Splitwise totals by more than one cent.'],
  ['Settlement-aware', 'Settlement-looking rows become first-class payment records instead of fake bills.'],
];
---

<Base meta={meta}>
  <Section
    eyebrow="Import"
    title="Bring your Splitwise CSV into an itemized ledger."
    body="Trezzit migration is a guided CSV flow, not a vague connector claim. It maps people, handles placeholders, recognizes settlement rows, and verifies the resulting balances before the import sticks."
  >
    <!-- Source: agents/team-briefs/landing-research-synthesis.md §3 -->
  </Section>

  <Section title="Upload, Group, You, Map, Done." className="bg-white/[0.02]">
    <!-- Source: frontend/src/components/csvImport/constants.js; frontend/src/components/csvImport/UniversalImportSheet.jsx -->
    <div class="mt-10 grid gap-4 md:grid-cols-5">
      {steps.map(([step, body], index) => (
        <div class="card-hover rounded-xl border border-white/10 bg-white/[0.03] p-5">
          <p class="font-mono text-xs text-brand-100">0{index + 1}</p>
          <h3 class="mt-3 text-lg font-semibold text-white">{step}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-400">{body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Ground truth" title="Five migration claims we can stand behind.">
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {claims.map(([title, body]) => (
        <article class="card-hover rounded-xl border border-white/10 bg-[#070815] p-5">
          <h3 class="text-lg font-semibold text-white">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section
    eyebrow="Boundary"
    title="No exchange-rate guessing."
    body="Trezzit groups lock currency at creation. The import reads the CSV currency column, but this page avoids cross-currency migration claims because balance verification is only safe when the export is effectively one currency."
    className="bg-white/[0.02]"
  >
    <!-- Source: agents/team-briefs/landing-research-synthesis.md §3 known limits and §1 claims 10-12 -->
    <a class="primary-cta mt-8 inline-flex rounded-full bg-brand-500 px-6 py-3 font-medium text-white hover:bg-brand-600" href="https://app.trezzit.com">Start importing</a>
  </Section>
</Base>
