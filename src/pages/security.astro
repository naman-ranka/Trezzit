---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ScopeMatrixPreview from '../components/preview/ScopeMatrixPreview.astro';

const meta = {
  title: 'Trezzit Security - OAuth scopes and data boundaries',
  description: 'Trezzit security boundaries for JWT cookies, OTP, Google OAuth, MCP OAuth scopes, AI write attribution, and placeholder-user data.',
  canonical: '/security',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Does Trezzit use MCP OAuth scopes?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Trezzit separates bills:read from bills:write over OAuth 2.1 with PKCE.' } },
      { '@type': 'Question', name: 'Can AI delete old bills?', acceptedAnswer: { '@type': 'Answer', text: 'MCP deletion is limited to AI-created bills inside a 30-minute mutation window.' } },
    ],
  },
};

const sections = [
  ['Web auth', 'The app supports email OTP flows, Google OAuth, and JWT sessions stored in cookies for the web experience.'],
  ['MCP OAuth', 'Remote MCP clients use OAuth 2.1 with PKCE rather than shared secrets pasted into chat.'],
  ['AI audit trail', '`AIAction` rows record MCP actions, inputs, outputs, success states, errors, and the AI agent involved.'],
  ['Mutation window', 'An agent can delete only a bill it created, and only inside the 30-minute MCP mutation window.'],
  ['Placeholder boundaries', 'Imported or invited placeholder people remain scoped to the group until a real user claims that placeholder through the join flow.'],
  ['Data limits', 'Trezzit does not claim bank sync, payment processing, native apps, or cross-currency exchange math today.'],
];
---

<Base meta={meta}>
  <Hero
    eyebrow="Security"
    title="Finance tools need explicit boundaries."
    description="Trezzit treats MCP as a scoped write surface, not an unbounded assistant. OAuth scopes, audit rows, attribution, and mutation windows define what agents can do."
    primaryLabel="Read AI docs"
    primaryHref="/ai"
    secondaryLabel="Try receipt demo"
    secondaryHref="https://app.trezzit.com/try-receipt"
  />
  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div class="fade-up">
        <p class="eyebrow">Scopes</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Read and write access are separate.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">`bills:read` lets agents inspect records. `bills:write` is required before any bill, settlement, or permitted deletion can happen.</p>
      </div>
      <div class="fade-up"><ScopeMatrixPreview /></div>
    </div>
  </section>
  <section class="section-pad border-t border-white/10 bg-[#060713]">
    <div class="container-page grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {sections.map(([title, body]) => (
        <article class="surface hover-card p-6 fade-up">
          <h2 class="text-xl font-semibold tracking-[-0.02em]">{title}</h2>
          <p class="mt-3 leading-relaxed text-slate-300">{body}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
