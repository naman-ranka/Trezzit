---
import Base from '../layouts/Base.astro';

const features = [
  ['Itemized Splitting', 'Every bill item breaks into inspectable person shares.', 'App UI exposes Equal, Percent, Exact, and Shares.', 'BillItem -> ItemShare'],
  ['Receipt Scanning', 'Gemini extracts merchant, totals, tax, discounts, and items.', 'Signed-in scans support JPEG, PNG, WebP, and PDF.', 'Walmart Â/ 6 rows'],
  ['CSV Import', 'Splitwise CSV in, fresh Trezzit group out, balances verified.', 'Fresh group only; tolerance is +/- $0.01.', 'UPLOAD -> RESULT'],
  ['Groups & Placeholders', 'Add friends by name before they create accounts.', 'Prior bills and payments transfer when they join.', 'Invited Â/ Joined'],
  ['Balances & Settlements', 'Balances roll up from item shares, bills, payments, and settlements.', 'Readable by person, group, and currency.', 'Maya owes $18.20'],
  ['Notifications', 'In-app and web-push infrastructure keeps group changes visible.', 'Copy avoids unverified inbox workflow claims.', 'Push ready'],
  ['Public Demos', 'Try a pre-scanned receipt demo and no-signup bill calculator.', 'Calculator does not persist data.', '/try-receipt Â/ /demo'],
  ['API & AI', '13 MCP tools over JSON-RPC 2.0 with OAuth 2.1.', '9 read, 3 write, 1 receipt-upload helper.', 'tools/call'],
];
---

<Base
  title="Trezzit Features - Itemized Splits, Receipts, Imports"
  description="Explore Trezzit's real expense features: item-level splits, Gemini receipt scanning, Splitwise CSV import, placeholder friends, web push, and public demos."
>
  <section class="border-b border-slate-800 bg-slate-950 py-16 md:py-24">
    <div class="section-shell">
      <p class="eyebrow">Feature inventory</p>
      <h1 class="mt-4 max-w-3xl text-5xl font-bold tracking-tight text-slate-50 md:text-7xl">Everything reads from the ledger.</h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-slate-400">A reference-quality map of shipped Trezzit surfaces. Each card includes a product claim, a status note, and a compact UI fragment instead of stock illustration.</p>
    </div>
  </section>

  <section class="bg-slate-900 py-16 md:py-24">
    <div class="section-shell grid gap-5 md:grid-cols-2">
      {features.map(([title, claim, status, fragment]) => (
        <article class="reveal rounded-2xl border border-slate-800 bg-slate-950/70 p-5 transition duration-150 hover:border-brand-500/30 hover:shadow-lg hover:shadow-indigo-500/10">
          <div class="rounded-xl border border-slate-700 bg-slate-900 p-4">
            <p class="font-mono text-[11px] uppercase tracking-wider text-brand-300">{fragment}</p>
            <div class="mt-4 grid grid-cols-3 gap-2">
              <span class="h-14 rounded-lg bg-slate-800"></span>
              <span class="h-14 rounded-lg bg-slate-800/70"></span>
              <span class="h-14 rounded-lg border border-brand-500/30 bg-brand-500/10"></span>
            </div>
          </div>
          <h2 class="mt-5 text-xl font-semibold text-slate-50">{title}</h2>
          <p class="mt-3 text-slate-300">{claim}</p>
          <p class="mt-3 text-sm text-slate-500">{status}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
