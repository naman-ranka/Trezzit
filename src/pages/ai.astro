---
import Base from '../layouts/Base.astro';

const clients = ['Claude', 'Cursor', 'ChatGPT', 'Gemini'];
const readTools = ['get_balances', 'get_context', 'search_bills', 'list_groups', 'get_group_details', 'resolve_participants', 'get_bill_details', 'get_expenses', 'get_person_info'];
const writeTools = ['create_bill', 'create_settlement', 'get_receipt_upload_presigned_url'];
const destructiveTools = ['delete_bill'];
const toolGroups = [
  { title: 'READ', tools: readTools, amber: false },
  { title: 'WRITE', tools: writeTools, amber: false },
  { title: 'DESTRUCTIVE', tools: destructiveTools, amber: true },
];
const config = `{
  "mcpServers": {
    "trezzit": {
      "command": "npx",
      "args": ["mcp-remote", "https://api.trezzit.com/api/mcp"],
      "auth": { "type": "oauth2-pkce" }
    }
  }
}`;
---

<Base
  title="Trezzit AI - MCP Tools for Your Expense Ledger"
  description="Connect MCP-compatible agents to Trezzit's itemized expense ledger with 13 JSON-RPC tools and OAuth 2.1."
>
  <section class="border-b border-slate-800 bg-slate-950 py-16 md:py-24">
    <div class="section-shell grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="eyebrow">MCP over itemized expenses</p>
        <h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-50 md:text-7xl">Connect your agent to the ledger.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">Trezzit exposes 13 tools over JSON-RPC 2.0 with OAuth 2.1, so compatible agents can read balances, inspect item rows, and create constrained writes.</p>
        <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-5">
          <div class="mb-4 flex flex-wrap gap-2">
            {clients.map((client, index) => <span class={`rounded-lg border px-3 py-1 text-xs ${index === 0 ? 'border-brand-500/40 bg-brand-500/10 text-brand-300' : 'border-slate-700 text-slate-400'}`}>{client}</span>)}
          </div>
          <pre class="overflow-x-auto rounded-xl bg-slate-950 p-4 text-sm leading-relaxed text-slate-200"><code>{config}</code></pre>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-indigo-500/10">
        <p class="font-mono text-[11px] uppercase tracking-wider text-brand-300">agent replay</p>
        <div class="mt-5 space-y-3 font-mono text-sm">
          <p class="rounded-lg bg-slate-950 p-3 text-slate-300">user: "How much did Maya owe from the cabin trip?"</p>
          <p class="rounded-lg bg-slate-950 p-3 text-brand-300">-&gt; called get_balances(&#123;group: "Cabin trip"&#125;)</p>
          <p class="rounded-lg bg-slate-950 p-3 text-slate-100">&lt;- Maya owes $18.20</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-800 bg-slate-900 py-8">
    <div class="section-shell flex flex-wrap items-center gap-4">
      <span class="text-xs uppercase tracking-wider text-slate-500">Works with</span>
      {clients.map((client) => <span class="text-sm font-semibold text-slate-300 opacity-60">{client}</span>)}
    </div>
  </section>

  <section id="tools" class="bg-slate-900 py-16 md:py-24">
    <div class="section-shell">
      <p class="eyebrow">13 tools</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-50">Read, write, and constrained delete.</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {toolGroups.map((group) => (
          <article class={`rounded-2xl border ${group.amber ? 'border-amber-500/30' : 'border-slate-800'} bg-slate-950/70 p-5`}>
            <h3 class={`font-mono text-xs font-semibold tracking-wider ${group.amber ? 'text-amber-300' : 'text-brand-300'}`}>{group.title}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.tools.map((tool) => <span class="rounded-lg border border-slate-800 bg-slate-900 px-2 py-1 font-mono text-[11px] text-slate-300">{tool}</span>)}
            </div>
          </article>
        ))}
      </div>
      <p id="oauth" class="mt-8 text-slate-400">Standard OAuth 2.1 with PKCE. No API keys. MCP writes are flat rate-limited; delete only applies to AI-created bills under 30 minutes old with no payments.</p>
    </div>
  </section>
</Base>
