---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const meta = {
  title: 'Trezzit MCP Server for AI Expense Queries',
  description: 'Trezzit exposes item-level expense data through MCP tools over JSON-RPC with OAuth 2.1 scopes, write limits, and AI-created bill attribution.',
  canonical: '/ai',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Trezzit MCP Server for AI Expense Queries',
  },
};

const readTools = ['get_context', 'list_groups', 'get_group_details', 'search_bills', 'get_bill_details', 'get_balances', 'get_expenses', 'get_person_info', 'resolve_participants'];
const writeTools = ['create_bill', 'delete_bill', 'create_settlement', 'get_receipt_upload_presigned_url'];
const toolCallExample = `{
  "jsonrpc": "2.0",
  "method": "tools/call",
  "params": {
    "name": "get_expenses",
    "arguments": {
      "group_id": "cabin-trip",
      "category": "Food",
      "date_from": "2026-05-01"
    }
  },
  "id": 7
}`;
---

<Base meta={meta}>
  <Section eyebrow="AI" title="Why MCP works here: item-level ledger." body="AI answers are only useful when the source data is precise. Trezzit can expose item shares directly, so an agent can explain which rows matched an answer." />
  <Section title="Protocol: JSON-RPC, tools/list, tools/call, OAuth 2.1 scopes." body="Trezzit's MCP server is backend-only. It speaks JSON-RPC, separates read and write scopes, and uses OAuth 2.1 with PKCE instead of shared chat secrets." className="bg-slate-950/50" />
  <Section title="The 13 tools.">
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      <div class="rounded-xl border border-slate-800 bg-slate-950 p-6">
        <h3 class="text-xl font-semibold text-white">Read</h3>
        <div class="mt-4 flex flex-wrap gap-2">{readTools.map((tool) => <span class="rounded-full bg-slate-800 px-3 py-1 font-mono text-sm text-slate-200">{tool}</span>)}</div>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-950 p-6">
        <h3 class="text-xl font-semibold text-white">Write and upload prep</h3>
        <div class="mt-4 flex flex-wrap gap-2">{writeTools.map((tool) => <span class="rounded-full bg-brand-500/15 px-3 py-1 font-mono text-sm text-brand-100">{tool}</span>)}</div>
      </div>
    </div>
  </Section>
  <Section title="Sample tool calls." className="bg-slate-950/50">
    <pre class="mt-8 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 p-5 text-sm text-slate-200"><code>{toolCallExample}</code></pre>
  </Section>
  <Section title="Safety model." body="Write access is scoped. Write requests are limited to 60 per minute and 600 per hour per OAuth session. AI-created bills carry attribution, and AI-created bill mutation is limited to a 30-minute window before normal app controls take over." />
  <Section title="Client setup." body="Claude, Cursor, ChatGPT, and Gemini-compatible MCP clients can connect because the protocol surface is provider-agnostic." className="bg-slate-950/50" />
</Base>
