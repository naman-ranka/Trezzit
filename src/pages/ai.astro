---
import Base from '../layouts/Base.astro';

const clients = ['Claude', 'Cursor', 'ChatGPT', 'Gemini'];
const tools = [
  ['create_bill', 'write', 'Create a bill with equal, itemized, percentage, or custom split.'],
  ['get_balances', 'read', 'Net balance snapshot by person, group, or currency.'],
  ['get_context', 'read', 'Profile, groups, members, recent bills, and pending settlements.'],
  ['search_bills', 'read', 'Search bills by text, date, or amount.'],
  ['list_groups', 'read', 'List non-deleted groups with optional fuzzy query.'],
  ['get_group_details', 'read', 'Return group details and member list.'],
  ['resolve_participants', 'read', 'Resolve fuzzy names to participant ids.'],
  ['create_settlement', 'write', 'Record a settlement payment and return updated balance.'],
  ['get_bill_details', 'read', 'Return bill, items, shares, payments, and participants.'],
  ['delete_bill', 'destructive write', 'Delete only AI-created bills under 30 minutes old with no payments.'],
  ['get_expenses', 'read', 'Read item-level expenses with category and tag context.'],
  ['get_person_info', 'read', 'Read person details when they share a mutual group.'],
  ['get_receipt_upload_presigned_url', 'receipt-upload helper', 'Return a presigned upload URL for receipt processing.'],
];
const readExample = `{
  "jsonrpc": "2.0",
  "id": "balances-1",
  "method": "tools/call",
  "params": {
    "name": "get_balances",
    "arguments": { "group_id": "berlin-trip" }
  }
}`;
const writeExample = `{
  "jsonrpc": "2.0",
  "id": "bill-1",
  "method": "tools/call",
  "params": {
    "name": "create_bill",
    "arguments": {
      "group_id": "berlin-trip",
      "description": "Groceries",
      "total_amount": "42.50",
      "currency": "USD",
      "split_method": "equal",
      "participants": ["person_aarav", "person_maya"]
    }
  }
}`;
---

<Base
  title="Trezzit AI — MCP Tools for Your Expense Ledger"
  description="Connect MCP-compatible agents to Trezzit's itemized expense ledger with 13 JSON-RPC tools and OAuth 2.1."
>
  <section class="border-b border-white/10 bg-slate-950 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-sm text-brand-300">MCP over itemized expenses</p>
      <h1 class="mt-4 text-4xl font-bold text-white md:text-6xl">AI can query the ledger.</h1>
      <p class="mt-5 max-w-3xl text-lg text-slate-300">Trezzit exposes read, write, and receipt-upload tools through JSON-RPC 2.0 and OAuth 2.1. The frontend does not yet include an MCP management UI.</p>
    </div>
  </section>
  <section class="bg-slate-900 px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8">
      <article class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <h2 class="text-2xl font-semibold text-white">MCP Overview</h2>
        <p class="mt-3 text-slate-300">Agents can inspect balances, search bills, read item-level expenses, create constrained bills and settlements, and request receipt upload URLs.</p>
      </article>
      <article class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <h2 class="text-2xl font-semibold text-white">Client Compatibility</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {clients.map((client) => <span class="rounded-lg border border-brand-300/30 px-4 py-2 text-brand-300">{client}</span>)}
        </div>
      </article>
      <article id="oauth" class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <h2 class="text-2xl font-semibold text-white">OAuth 2.1 Flow</h2>
        <div class="mt-4 grid gap-3 text-sm text-slate-300 md:grid-cols-4">
          <div class="rounded-lg bg-slate-800 p-4">Authorize</div>
          <div class="rounded-lg bg-slate-800 p-4">Token</div>
          <div class="rounded-lg bg-slate-800 p-4">MCP call</div>
          <div class="rounded-lg bg-slate-800 p-4">Ledger result</div>
        </div>
      </article>
      <article id="tools" class="overflow-hidden rounded-xl border border-white/10 bg-slate-950">
        <div class="p-6">
          <h2 class="text-2xl font-semibold text-white">13-Tool Inventory</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] text-left text-sm">
            <thead class="bg-slate-900 text-slate-400">
              <tr><th class="px-6 py-3">Tool</th><th class="px-6 py-3">Type</th><th class="px-6 py-3">Purpose</th></tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-slate-300">
              {tools.map(([tool, type, purpose]) => <tr><td class="px-6 py-3 font-mono text-brand-300">{tool}</td><td class="px-6 py-3">{type}</td><td class="px-6 py-3">{purpose}</td></tr>)}
            </tbody>
          </table>
        </div>
      </article>
      <article id="rate-limits" class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <h2 class="text-2xl font-semibold text-white">Rate Limits</h2>
        <p class="mt-3 text-slate-300">Writes are limited to 5 per minute and 30 per hour. Reads are limited to 60 per minute and 600 per hour. Limits are flat per token, not paid-tier quotas.</p>
      </article>
      <article class="grid gap-4 rounded-xl border border-white/10 bg-slate-950 p-6 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-semibold text-white">JSON-RPC Read</h2>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-slate-900 p-4 text-sm text-slate-200"><code>{readExample}</code></pre>
        </div>
        <div>
          <h2 class="text-2xl font-semibold text-white">JSON-RPC Write</h2>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-slate-900 p-4 text-sm text-slate-200"><code>{writeExample}</code></pre>
        </div>
      </article>
      <article class="rounded-xl border border-white/10 bg-slate-950 p-6">
        <h2 class="text-2xl font-semibold text-white">Known Limitations</h2>
        <p class="mt-3 text-slate-300">No frontend MCP management UI yet — this is roadmap. MCP management screenshots should not be represented as shipped app UI in this scaffold.</p>
      </article>
    </div>
  </section>
</Base>
