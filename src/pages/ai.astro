---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SetupSnippetPreview from '../components/preview/SetupSnippetPreview.astro';
import ToolInventoryPreview from '../components/preview/ToolInventoryPreview.astro';
import ScopeMatrixPreview from '../components/preview/ScopeMatrixPreview.astro';
import McpConversationPreview from '../components/preview/McpConversationPreview.astro';

const meta = {
  title: 'Trezzit MCP Server - AI tools for expenses',
  description: 'Connect Claude, Cursor, ChatGPT, or Gemini-compatible MCP clients to Trezzit for scoped expense reads, receipt uploads, and attributed bill writes.',
  canonical: '/ai',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Trezzit MCP Server',
    description: 'OAuth 2.1 MCP tools for itemized expense records.',
  },
};

const examples = [
  ['get_expenses', `{
  "jsonrpc": "2.0",
  "id": 101,
  "method": "tools/call",
  "params": {
    "name": "get_expenses",
    "arguments": {
      "start_date": "2026-05-01",
      "end_date": "2026-05-31",
      "category": "Coffee",
      "group_id": 18,
      "limit": 50
    }
  }
}`],
  ['create_bill', `{
  "jsonrpc": "2.0",
  "id": 102,
  "method": "tools/call",
  "params": {
    "name": "create_bill",
    "arguments": {
      "title": "Trattoria Romano",
      "amount": 86.94,
      "group_id": 18,
      "date": "2026-05-21",
      "split_method": "itemized",
      "items": [
        { "name": "Margherita Pizza", "price": 18.00, "split_among": [7, 9] },
        { "name": "Espresso (x2)", "price": 6.00, "split_among": [11] }
      ]
    }
  }
}`],
  ['search_bills', `{
  "jsonrpc": "2.0",
  "id": 103,
  "method": "tools/call",
  "params": {
    "name": "search_bills",
    "arguments": {
      "query": "coffee",
      "start_date": "2026-05-01",
      "end_date": "2026-05-31",
      "limit": 20
    }
  }
}`],
];
---

<Base meta={meta}>
  <Hero
    eyebrow="MCP server"
    title="Connect your AI to itemized money records."
    description="Trezzit exposes expense data through real MCP tools over OAuth 2.1. Agents can search bills, read balances, inspect item shares, upload receipts, and create attributed bill records."
    primaryLabel="Connect from clients"
    primaryHref="#connect"
    secondaryLabel="See tool catalog"
    secondaryHref="#tools"
  />

  <section id="connect" class="section-pad">
    <div class="container-page">
      <div class="max-w-3xl fade-up">
        <p class="eyebrow">Setup</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Connect from MCP clients.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">Claude, Cursor, ChatGPT, and Gemini-compatible clients can connect to the same remote OAuth-backed endpoint. Exact client UI varies; the boundary is JSON-RPC over MCP.</p>
      </div>
      <div class="mt-10 fade-up"><SetupSnippetPreview /></div>
    </div>
  </section>

  <section class="section-pad border-y border-white/10 bg-[#060713]">
    <div class="container-page grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">OAuth 2.1</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Scopes separate reading from writing.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">Trezzit uses OAuth 2.1 with PKCE. `bills:read` enables inspection and upload preparation. `bills:write` enables bill creation, settlement creation, and deleting AI-created bills inside the mutation window.</p>
      </div>
      <div class="fade-up"><ScopeMatrixPreview /></div>
    </div>
  </section>

  <section id="tools" class="section-pad">
    <div class="container-page">
      <div class="max-w-3xl fade-up">
        <p class="eyebrow">Tool catalog</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">13 tools, named plainly.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">Read tools inspect context, groups, bills, balances, people, item-share expenses, and receipt upload preparation. Write tools create bills, create settlements, and delete recent AI-created bills.</p>
      </div>
      <div class="mt-10 fade-up"><ToolInventoryPreview /></div>
    </div>
  </section>

  <section class="section-pad border-y border-white/10 bg-[#060713]">
    <div class="container-page grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
      <div class="fade-up">
        <p class="eyebrow">Conversation</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">The agent can ask ledger questions.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">A coffee question can resolve to a tool call, a group filter, and item-level matches instead of a guessed answer from chat history.</p>
      </div>
      <div class="fade-up"><McpConversationPreview /></div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <div class="max-w-3xl fade-up">
        <p class="eyebrow">JSON-RPC</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Sample tool calls.</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-300">These examples use the endpoint shape implemented by the MCP view: `tools/call` with a tool name and argument object.</p>
      </div>
      <div class="mt-10 grid gap-4">
        {examples.map(([name, code]) => (
          <article class="surface overflow-hidden bg-[#060713]">
            <div class="border-b border-white/10 px-4 py-3"><code class="font-mono text-sm text-brand-300">{name}</code></div>
            <div class="overflow-hidden p-4 text-sm"><Code code={code} lang="json" theme="vitesse-dark" /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad border-y border-white/10 bg-[#060713]">
    <div class="container-page grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <div class="md:col-span-2 lg:col-span-4 fade-up">
        <p class="eyebrow">Mutation safety</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Write tools leave a trail.</h2>
      </div>
      {[
        ['Attribution', 'Bills created through MCP carry AI-client attribution through token metadata.'],
        ['Audit', 'MCP writes and read actions create `AIAction` audit rows with inputs, outputs, success, and errors.'],
        ['Rate limits', 'Write calls use dual-window rate limits: 60 requests per minute and 600 per hour per OAuth session.'],
        ['Delete window', 'MCP deletion is limited to the agent’s own AI-created bill inside a 30-minute window.'],
      ].map(([title, body]) => (
        <article class="surface hover-card p-6 fade-up"><h3 class="text-lg font-semibold">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-300">{body}</p></article>
      ))}
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <div class="max-w-3xl fade-up">
        <p class="eyebrow">Known limits</p>
        <h2 class="mt-4 text-2xl font-semibold tracking-[-0.03em] md:text-3xl">Boundaries stated plainly.</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {['No bank sync.', 'No Stripe or paid Pro plan today.', 'No native iOS or Android app-store apps.', 'No cross-currency totals or exchange-rate math.'].map((limit) => (
          <div class="surface hover-card p-6 text-lg text-slate-200 fade-up">{limit}</div>
        ))}
      </div>
    </div>
  </section>
</Base>
