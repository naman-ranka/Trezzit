---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const meta = {
  title: 'Trezzit MCP Server for AI Expense Queries',
  description: 'Trezzit exposes item-level expense data through MCP tools over JSON-RPC with OAuth 2.1 scopes, write limits, and AI-created bill attribution.',
  canonical: '/ai',
  schema: {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Trezzit MCP Server for AI Expense Queries',
  },
};

const tools = [
  ['get_context', 'Read', 'Current user, available groups, and server capability context.'],
  ['list_groups', 'Read', 'Groups the authorized person can inspect.'],
  ['get_group_details', 'Read', 'Group members, currency, balances, and metadata.'],
  ['search_bills', 'Read', 'Bill search across merchant names, descriptions, and dates.'],
  ['get_bill_details', 'Read', 'Line items, participants, item shares, and audit-friendly bill detail.'],
  ['get_balances', 'Read', 'Who owes whom inside the authorized group context.'],
  ['get_expenses', 'Read', 'Item-share expense rows filtered by dates, groups, categories, tags, and search.'],
  ['get_person_info', 'Read', 'Person records needed to resolve bill participants.'],
  ['resolve_participants', 'Read', 'Name matching before a create_bill mutation.'],
  ['get_receipt_upload_presigned_url', 'Read', 'Upload preparation for receipt bytes before bill creation.'],
  ['create_bill', 'Write', 'Creates an attributed bill from structured bill and item-share data.'],
  ['delete_bill', 'Write', 'Deletes an AI-created bill only inside the allowed mutation window.'],
  ['create_settlement', 'Write', 'Records a settlement payment between people.'],
];

const listExample = `{
  "jsonrpc": "2.0",
  "method": "tools/list",
  "params": {},
  "id": 1
}`;

const callExample = `{
  "jsonrpc": "2.0",
  "method": "tools/call",
  "params": {
    "name": "get_expenses",
    "arguments": {
      "group_id": "cabin-trip",
      "category": "Food",
      "date_from": "2026-05-01",
      "date_to": "2026-05-31"
    }
  },
  "id": 7
}`;
---

<Base meta={meta}>
  <Section
    eyebrow="AI"
    title="MCP works because the ledger is item-level."
    body="Trezzit does not expose a chatbot over vague transaction blobs. It exposes MCP tools over item shares, bill items, group balances, and settlements, so an agent can cite the exact rows behind an answer."
  />

  <Section
    eyebrow="Protocol"
    title="JSON-RPC tools, OAuth 2.1 scopes."
    body="The server is backend-only and provider-agnostic. Clients call tools/list and tools/call over JSON-RPC after OAuth 2.1 with PKCE; bills:read and bills:write scopes keep query access separate from mutations."
    className="bg-white/[0.02]"
  >
    <!-- Source: agents/team-briefs/landing-research-synthesis.md §2; backend/bills_new/mcp/oauth/models.py:49-87 -->
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="overflow-hidden rounded-xl border border-white/10 bg-[#070815]">
        <div class="border-b border-white/10 px-4 py-3 font-mono text-xs uppercase tracking-widest text-slate-400">tools/list</div>
        <Code code={listExample} lang="json" theme="vitesse-dark" />
      </div>
      <div class="overflow-hidden rounded-xl border border-white/10 bg-[#070815]">
        <div class="border-b border-white/10 px-4 py-3 font-mono text-xs uppercase tracking-widest text-slate-400">tools/call</div>
        <Code code={callExample} lang="json" theme="vitesse-dark" />
      </div>
    </div>
  </Section>

  <Section eyebrow="Inventory" title="The 13 tools.">
    <!-- Source: backend/bills_new/views_dir/mcp_server_views.py tool registry summarized in agents/team-briefs/landing-research-synthesis.md §2 -->
    <div class="mt-10 overflow-hidden rounded-xl border border-white/10 bg-[#070815]">
      <div class="grid grid-cols-[1fr_96px_1.5fr] border-b border-white/10 bg-white/[0.03] px-4 py-3 font-mono text-xs uppercase tracking-widest text-slate-500">
        <span>Tool</span>
        <span>Scope</span>
        <span>What it gives the agent</span>
      </div>
      <div class="divide-y divide-white/10">
        {tools.map(([tool, scope, description]) => (
          <div class="grid gap-3 px-4 py-4 text-sm md:grid-cols-[1fr_96px_1.5fr]">
            <span class="font-mono text-slate-100">{tool}</span>
            <span class={`font-mono text-xs uppercase tracking-wider ${scope === 'Write' ? 'text-brand-100' : 'text-slate-400'}`}>{scope}</span>
            <span class="leading-6 text-slate-300">{description}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Scopes"
    title="Read and write are separate decisions."
    body="A read-only client can inspect groups, bills, balances, expenses, people, and receipt-upload preparation. A write-scoped client can create bills, delete eligible AI-created bills, and create settlements."
    className="bg-white/[0.02]"
  >
    <!-- Source: agents/team-briefs/landing-research-synthesis.md §2 auth + safety -->
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="card-hover rounded-xl border border-white/10 bg-white/[0.03] p-5">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-400">bills:read</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">Search bills, inspect balances, resolve people, and query item-share expenses.</p>
      </div>
      <div class="card-hover rounded-xl border border-white/10 bg-white/[0.03] p-5">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-400">bills:write</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">Create attributed bills and settlements with per-session write limits.</p>
      </div>
      <div class="card-hover rounded-xl border border-white/10 bg-white/[0.03] p-5">
        <p class="font-mono text-xs uppercase tracking-widest text-slate-400">mutation window</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">AI-created bills can be edited or deleted by the agent only inside the 30-minute window.</p>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Clients"
    title="Works with MCP-capable clients."
    body="Claude Code, Claude Desktop, Cursor, ChatGPT, Gemini-compatible clients, and any client that speaks MCP can connect to the same tool surface. Trezzit does not require a provider-specific integration."
  />
</Base>
