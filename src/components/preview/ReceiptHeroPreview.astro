---
const people = [
  ['You', 'bg-[#0a0f3c]'],
  ['Aarav', 'bg-amber-500'],
  ['Maya', 'bg-emerald-500'],
];
const items = [
  ['Margherita Pizza', '$18.00', 'Food & Dining', 'You'],
  ['Carbonara', '$16.00', 'Food & Dining', 'Aarav'],
  ['Caesar Salad', '$12.00', 'Food & Dining', 'Maya'],
  ['Sparkling Water (x3)', '$9.00', 'Drinks', 'Aarav'],
  ['Tiramisu', '$8.00', 'Desserts', 'You'],
  ['Espresso (x2)', '$6.00', 'Coffee', 'Maya'],
];
---

<div class="card-hover mx-auto mt-10 max-w-[480px] rounded-[28px] border border-white/10 bg-gradient-to-b from-slate-50 to-white p-5 text-slate-950 shadow-2xl shadow-black/30">
  <div class="text-center">
    <span class="inline-block rounded-full bg-amber-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-amber-600">
      Sample receipt - try the split
    </span>
    <h3 class="mt-4 text-[24px] font-semibold leading-tight tracking-tight text-[#0a0f3c]">
      Scan receipts. Split exact items. Track your share.
    </h3>
    <p class="mt-2 text-[13px] text-slate-500">
      Tap an item to assign it. Watch your share auto-categorized update live.
    </p>
  </div>

  <section class="mt-7 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-dashed border-slate-200 px-5 py-4 text-center">
      <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">Trattoria Romano</p>
      <p class="text-[11px] text-slate-400">Saturday - table 7 - 3 guests</p>
    </div>

    <ul class="divide-y divide-slate-100">
      {items.map(([name, amount, category, owner]) => (
        <li class="px-5 py-3.5">
          <div class="flex items-baseline justify-between gap-3">
            <p class="truncate text-[14px] font-semibold text-[#0a0f3c]">{name}</p>
            <p class="text-[14px] font-semibold text-[#0a0f3c]">{amount}</p>
          </div>
          <p class="mt-0.5 text-[11px] text-slate-400">{category}</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {people.map(([person, color]) => (
              <span class={`inline-flex min-h-[34px] items-center gap-1.5 rounded-full px-3 py-1.5 text-[12px] font-semibold ${owner === person ? 'bg-[#0a0f3c] text-white shadow-sm' : 'border border-slate-200 bg-white text-slate-600'}`}>
                <span class={`inline-block h-2 w-2 rounded-full ${color}`} />
                {person}
              </span>
            ))}
          </div>
        </li>
      ))}
    </ul>

    <div class="border-t border-dashed border-slate-200 px-5 py-3 text-[12px] text-slate-500">
      <div class="flex justify-between"><span>Subtotal</span><span>$69.00</span></div>
      <div class="flex justify-between"><span>Tax (8%)</span><span>$5.52</span></div>
      <div class="flex justify-between"><span>Tip (18%)</span><span>$12.42</span></div>
      <div class="mt-1 flex justify-between border-t border-slate-100 pt-1.5 text-[13px] font-semibold text-[#0a0f3c]">
        <span>Total</span><span>$86.94</span>
      </div>
    </div>
  </section>

  <section class="mt-6 overflow-hidden rounded-3xl bg-[#0a0f3c] p-5 text-white shadow-lg">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-white/70">Your share, auto-tracked</p>
    <div class="mt-2 flex items-baseline justify-between gap-3">
      <span class="text-[28px] font-semibold leading-tight">$32.76</span>
      <span class="rounded-full bg-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider">Food & Dining</span>
    </div>
    <p class="mt-3 text-[12px] text-white/70">
      Every item you assign to yourself flows into your personal expense ledger, tagged by category.
    </p>
  </section>
</div>
