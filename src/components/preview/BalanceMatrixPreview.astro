---
const owed = [
  ['Mike', '$42.18', 'owes you', 'M', 'bg-indigo-600'],
  ['Aarav', '$19.40', 'owes you', 'A', 'bg-amber-500'],
];
const owe = [
  ['Maya', '$14.25', 'you owe', 'M', 'bg-emerald-500'],
];
const around = [
  ['Chetan', '$31.10', 'owed'],
  ['Prachi', '$8.50', 'owes'],
  ['Adi', '', 'settled'],
];
---

<article class="mx-auto max-w-[390px] rounded-2xl border border-slate-200 bg-white p-5 text-slate-950 shadow-2xl shadow-black/25">
  <div class="mb-4">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-slate-400">Cabin Trip</p>
    <h3 class="mt-1 text-xl font-semibold tracking-tight text-[#0a0f3c]">Balances</h3>
  </div>

  <section>
    <div class="flex items-baseline justify-between pb-1 pt-2">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">You're owed</p>
      <p class="text-xs font-semibold text-emerald-600">$61.58</p>
    </div>
    <div class="divide-y divide-slate-100">
      {owed.map(([name, amount, relation, initial, color]) => (
        <div class="flex items-center gap-3 py-3">
          <span class={`flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-white ${color}`}>{initial}</span>
          <div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-slate-900">{name}</p><p class="text-xs text-slate-500">{relation}</p></div>
          <span class="text-sm font-semibold text-emerald-600">{amount}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="flex items-baseline justify-between pb-1 pt-3">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">You owe</p>
    </div>
    <div class="divide-y divide-slate-100">
      {owe.map(([name, amount, relation, initial, color]) => (
        <div class="flex items-center gap-3 py-3">
          <span class={`flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-white ${color}`}>{initial}</span>
          <div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-slate-900">{name}</p><p class="text-xs text-slate-500">{relation}</p></div>
          <span class="text-sm font-semibold text-red-500">{amount}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="flex w-full items-center justify-between pb-1 pt-5">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">Around the group ({around.length})</p>
      <span class="text-slate-400">⌄</span>
    </div>
    <div class="divide-y divide-slate-100">
      {around.map(([name, amount, relation]) => (
        <div class={`flex items-center gap-3 py-3 ${relation === 'settled' ? 'opacity-55' : ''}`}>
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-500">{name[0]}</span>
          <div class="min-w-0 flex-1"><p class="truncate text-sm font-medium text-slate-900">{name}</p><p class="text-xs text-slate-500">{relation}</p></div>
          <span class={`text-sm font-semibold ${relation === 'owed' ? 'text-emerald-600' : relation === 'owes' ? 'text-red-500' : 'text-slate-400'}`}>{amount}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 text-xs text-slate-400">
    <span>View history</span><span>·</span><span>Simplified</span><span>·</span><span>Record a payment</span>
  </div>
</article>
