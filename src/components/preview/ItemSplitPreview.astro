---
const members = [
  ['You', '$18.75', 'bg-brand-500', '18.75'],
  ['Maya', '$12.25', 'bg-emerald-500', '12.25'],
  ['Aarav', '$9.00', 'bg-amber-500', '9.00'],
  ['Nico', '$4.00', 'bg-sky-500', '4.00'],
];
const splitTypes = ['Equal', 'Percent', 'Exact', 'Shares', 'Proportional'];
---

<div class="card-hover mt-10 mx-auto max-w-xl rounded-2xl border border-white/10 bg-white p-5 text-slate-950 shadow-2xl shadow-black/30">
  <div class="mb-5 flex items-center justify-between">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">Cabin Trip</p>
      <h3 class="mt-1 text-base font-medium text-slate-950">Trader Joe's grocery run</h3>
    </div>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">4 people</span>
  </div>

  <div class="mb-3 flex items-start justify-between px-1">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5">
        <div class="text-base font-medium leading-tight text-[#0a0f3c]">Breakfast supplies</div>
      </div>
      <div class="mt-0.5 text-xs text-slate-400">Qty: 1</div>
    </div>
    <div class="ml-3 text-right">
      <div class="mb-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Total</div>
      <div class="text-[22px] font-bold leading-none text-slate-900">$44.00</div>
    </div>
  </div>

  <div class="mb-3">
    <div class="mb-2 flex items-center justify-between px-1">
      <div class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Split Type</div>
    </div>
    <div class="flex gap-1 overflow-x-auto rounded-xl bg-slate-100 p-1">
      {splitTypes.map((type) => (
        <span class={`shrink-0 rounded-lg px-3 py-1.5 text-[11px] font-semibold ${type === 'Exact' ? 'bg-white text-[#0a0f3c] shadow-sm' : 'text-slate-500'}`}>
          {type}
        </span>
      ))}
    </div>
  </div>

  <div class="mb-2">
    <div class="flex items-center justify-between px-1">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Split With</span>
        <span class="text-[12px] font-bold text-brand-600">4</span>
      </div>
      <span class="text-[13px] font-semibold text-slate-400">Clear</span>
    </div>
  </div>

  <div class="overflow-hidden rounded-xl bg-slate-50">
    {members.map(([name, amount, color, input]) => (
      <div class="flex items-center gap-3 px-3 py-3">
        <span class={`grid h-8 w-8 place-items-center rounded-full text-xs font-bold text-white ${color}`}>{name.slice(0, 1)}</span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold text-[#0a0f3c]">{name}</p>
          <p class="text-xs text-slate-400">included</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="rounded-lg border border-slate-200 bg-white px-2.5 py-1.5 text-right font-mono text-sm text-slate-900">{input}</span>
          <span class="w-16 text-right text-sm font-semibold text-[#0a0f3c]">{amount}</span>
        </div>
      </div>
    ))}
  </div>
</div>
