---
export interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  className?: string;
}

const { eyebrow, title, body, className = '' } = Astro.props;
---

<section data-animate="fade-up" class={`px-6 py-16 md:py-24 ${className}`}>
  <div class="mx-auto max-w-6xl">
    {eyebrow && <p class="mb-4 font-mono text-xs uppercase tracking-widest text-slate-400">{eyebrow}</p>}
    <h2 class="max-w-3xl text-2xl font-semibold tracking-[-0.03em] text-white md:text-3xl">{title}</h2>
    {body && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{body}</p>}
    <slot />
  </div>
</section>
