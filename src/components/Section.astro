---
export interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  className?: string;
}

const { eyebrow, title, body, className = '' } = Astro.props;
---

<section class={`px-6 py-16 md:py-24 ${className}`}>
  <div class="mx-auto max-w-6xl">
    {eyebrow && <p class="mb-4 text-sm font-semibold uppercase tracking-[0.16em] text-brand-100">{eyebrow}</p>}
    <h2 class="max-w-3xl text-3xl font-semibold tracking-tight text-white md:text-5xl">{title}</h2>
    {body && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-300">{body}</p>}
    <slot />
  </div>
</section>
