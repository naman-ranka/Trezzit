---
const productLinks = [
  { label: 'Ledger', href: '/#ledger' },
  { label: 'Receipts', href: '/#receipts' },
  { label: 'Imports', href: '/#imports' },
  { label: 'Groups', href: '/#groups' },
];
const navLinks = [
  { label: 'Features', href: '/features' },
  { label: 'AI', href: '/ai' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Changelog', href: '/changelog' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3 font-semibold text-white">
      <img src="/assets/icons/trezzit-icon-square.webp" alt="" class="h-8 w-8 rounded-lg" />
      <span>Trezzit</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-slate-300 md:flex" aria-label="Primary">
      <details class="group relative">
        <summary class="cursor-pointer list-none hover:text-white">Product</summary>
        <div class="absolute left-0 top-8 w-44 rounded-lg border border-white/10 bg-slate-950 p-2 shadow-xl">
          {productLinks.map((link) => (
            <a class="block rounded-md px-3 py-2 hover:bg-white/10 hover:text-white" href={link.href}>{link.label}</a>
          ))}
        </div>
      </details>
      {navLinks.map((link) => <a class="hover:text-white" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a href="https://app.trezzit.com/login" class="px-3 py-2 text-sm font-medium text-slate-300 hover:text-white">Login</a>
      <a href="https://app.trezzit.com/signup" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-medium text-white hover:bg-brand-400">Sign up free</a>
    </div>
    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-white/10 text-sm text-slate-200">Menu</summary>
      <div class="absolute right-0 top-12 w-64 rounded-lg border border-white/10 bg-slate-950 p-3 shadow-xl">
        <p class="px-3 pb-2 text-xs uppercase tracking-wide text-brand-300">Product</p>
        {productLinks.map((link) => <a class="block rounded-md px-3 py-2 text-slate-300 hover:bg-white/10 hover:text-white" href={link.href}>{link.label}</a>)}
        <div class="my-2 border-t border-white/10"></div>
        {navLinks.map((link) => <a class="block rounded-md px-3 py-2 text-slate-300 hover:bg-white/10 hover:text-white" href={link.href}>{link.label}</a>)}
        <a href="https://app.trezzit.com/login" class="mt-2 block rounded-md px-3 py-2 text-slate-300 hover:bg-white/10 hover:text-white">Login</a>
        <a href="https://app.trezzit.com/signup" class="mt-2 block rounded-lg bg-brand-500 px-4 py-2 text-center font-medium text-white">Sign up free</a>
      </div>
    </details>
  </div>
</header>
