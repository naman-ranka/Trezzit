---
const nav = [
  { href: '/ai', label: 'AI' },
  { href: '/demos', label: 'Demos' },
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/security', label: 'Security' },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0A0B1A]/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 font-semibold text-white" aria-label="Trezzit home">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 font-semibold shadow-[0_0_24px_rgba(79,70,229,0.22)]">T</span>
      <span>Trezzit</span>
    </a>
    <nav class="hidden items-center gap-5 text-sm text-slate-300 md:flex" aria-label="Primary navigation">
      {nav.map((item) => <a class="transition hover:text-white" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a class="hidden text-sm font-medium text-slate-300 transition hover:text-white sm:inline-flex" href="https://app.trezzit.com/try-receipt">Try demo</a>
      <a class="btn-primary px-4 py-2 text-sm" href="/ai">Connect</a>
    </div>
  </div>
</header>
