---
const demoItems = [
  { label: 'Receipt demo', href: 'https://app.trezzit.com/try-receipt' },
  { label: 'Bill calculator', href: 'https://app.trezzit.com/demo' },
];

const navItems = [
  { label: 'Features', href: '/features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'AI', href: '/ai' },
  { label: 'Changelog', href: '/changelog' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900/80 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="flex items-center gap-3 text-sm font-semibold text-white">
      <img src="/assets/icons/trezzit-icon-square.webp" alt="" class="h-8 w-8 rounded-lg" />
      <span>Trezzit</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      <details class="group relative">
        <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-xl px-3 py-2 text-sm font-medium text-brand-100 hover:bg-slate-800">
          Try demo
        </summary>
        <div class="absolute left-0 mt-2 w-60 rounded-2xl border border-slate-700 bg-slate-950 p-2 shadow-2xl shadow-black/40">
          {demoItems.map((item) => (
            <a class="block rounded-xl px-3 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white" href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
      {navItems.map((item) => (
        <a class="flex min-h-11 items-center rounded-xl px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white" href={item.href}>
          {item.label}
        </a>
      ))}
      <a class="flex min-h-11 items-center rounded-xl px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white" href="https://app.trezzit.com/login">
        Login
      </a>
      <a class="ml-2 flex min-h-11 items-center rounded-xl bg-brand-500 px-4 py-2 text-sm font-semibold text-white shadow-[0_0_24px_-8px_rgba(79,70,229,0.8)] hover:bg-brand-400" href="https://app.trezzit.com/signup">
        Sign up free
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <details class="relative">
        <summary class="min-h-11 cursor-pointer list-none rounded-xl bg-brand-500 px-3 py-3 text-sm font-semibold text-white">
          Try demo
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-slate-700 bg-slate-950 p-2 shadow-2xl shadow-black/40">
          {demoItems.map((item) => (
            <a class="block rounded-xl px-3 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white" href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
      <details class="relative">
        <summary class="min-h-11 cursor-pointer list-none rounded-xl border border-slate-700 px-3 py-3 text-sm text-slate-100">
          Menu
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-slate-700 bg-slate-950 p-2 shadow-2xl shadow-black/40">
          {navItems.map((item) => (
            <a class="block rounded-xl px-3 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white" href={item.href}>
              {item.label}
            </a>
          ))}
          <a class="block rounded-xl px-3 py-3 text-sm text-slate-200 hover:bg-slate-800 hover:text-white" href="https://app.trezzit.com/login">Login</a>
          <a class="mt-1 block rounded-xl bg-brand-500 px-3 py-3 text-sm font-semibold text-white hover:bg-brand-400" href="https://app.trezzit.com/signup">Sign up free</a>
        </div>
      </details>
    </div>
  </nav>
</header>
