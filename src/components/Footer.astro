---
const links = [
  ['Ledger', '/ledger'],
  ['Features', '/features'],
  ['AI', '/ai'],
  ['Import', '/import'],
  ['Pricing', '/pricing'],
  ['Changelog', '/changelog'],
];
---

<footer class="border-t border-white/10 bg-[#070815]">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-[1fr_auto]">
    <div>
      <div class="flex items-center gap-3 font-semibold text-white">
        <span class="grid size-8 place-items-center rounded-lg bg-brand-500 text-sm font-semibold">T</span>
        <span>Trezzit</span>
      </div>
      <p class="mt-4 max-w-xl text-sm leading-6 text-slate-400">
        An itemized ledger for shared expenses. Split receipts, preserve item shares, and let AI answer from the same rows the app uses.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-x-8 gap-y-3 text-sm text-slate-400 md:grid-cols-3">
      {links.map(([label, href]) => <a class="hover:text-white" href={href}>{label}</a>)}
    </div>
  </div>
</footer>
