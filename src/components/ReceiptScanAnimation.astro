    margin: 0.6rem 0;
  }
  .grand-total {
    border-top: 1px dashed #94a3b8;
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    font-weight: 800;
  }
  .scan-grid {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image: linear-gradient(rgba(79,70,229,0.25) 1px, transparent 1px), linear-gradient(90deg, rgba(79,70,229,0.25) 1px, transparent 1px);
    background-size: 28px 28px;
    transition: opacity 400ms ease;
  }
  .scan-grid.active {
