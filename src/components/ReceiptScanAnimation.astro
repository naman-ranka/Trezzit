    border-radius: 999px;
    background: #4F46E5;
  }
  .parsed-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 0.65rem 0;
