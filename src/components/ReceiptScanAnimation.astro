<div class="receipt-demo" data-receipt-demo>
  <div class="receipt-section">
    <div class="receipt-container">
      <div class="scan-grid"></div>
      <div class="scan-line"></div>
      <div class="receipt">
        <div class="store-header">
          <div class="store-name">TREZZIT MCP SERVER BILL</div>
          <div class="store-address">Developer dinner - table 7</div>
        </div>
        <div class="items">
          <div class="item"><span class="item-name">HANDMADE PASTA</span><span class="item-price">$18.00</span></div>
          <div class="item"><span class="item-name">HOUSE SALAD</span><span class="item-price">$12.50</span></div>
          <div class="item"><span class="item-name">SPARKLING WATER</span><span class="item-price">$6.00</span></div>
          <div class="item"><span class="item-name">ESPRESSO</span><span class="item-price">$4.50</span></div>
          <div class="separator"></div>
          <div class="item"><span class="item-name">TAX</span><span class="item-price">$3.28</span></div>
          <div class="item"><span class="item-name">TIP</span><span class="item-price">$8.20</span></div>
        </div>
        <div class="total-section">
          <div class="total-line grand-total"><span>TOTAL</span><span>$52.48</span></div>
        </div>
      </div>
    </div>
  </div>
  <div class="parsed-section">
    <div class="data-card metadata-card">
      <div class="metadata-grid">
        <div><span>Merchant</span><strong data-value="merchant"></strong></div>
        <div><span>Date</span><strong data-value="date"></strong></div>
        <div><span>Total</span><strong data-value="total"></strong></div>
        <div><span>Tax</span><strong data-value="tax"></strong></div>
      </div>
    </div>
    <div class="data-card items-card">
      <div class="card-header">
        <span class="card-dot"></span>
        <strong>Structured items</strong>
      </div>
      <div class="items-list"></div>
    </div>
  </div>
</div>

<script>
  const receiptData = {
    merchant: 'Trattoria Romano',
    date: 'May 21, 2026',
    total: '$52.48',
    tax: '$3.28',
    items: [
      ['Handmade pasta', '$18.00', 'Food'],
      ['House salad', '$12.50', 'Food'],
      ['Sparkling water', '$6.00', 'Drinks'],
      ['Espresso', '$4.50', 'Coffee'],
      ['Tax', '$3.28', 'Tax'],
      ['Tip', '$8.20', 'Tip']
    ]
  };

  function runReceiptDemo(root) {
    if (!root || root.dataset.played === 'true') return;
    root.dataset.played = 'true';
    const receiptSection = root.querySelector('.receipt-section');
    const scanGrid = root.querySelector('.scan-grid');
    const scanLine = root.querySelector('.scan-line');
    const parsed = root.querySelector('.parsed-section');
    const metadata = root.querySelector('.metadata-card');
    const itemsCard = root.querySelector('.items-card');
    const list = root.querySelector('.items-list');

    setTimeout(() => {
      receiptSection?.classList.add('scanning');
      scanGrid?.classList.add('active');
    }, 150);
    setTimeout(() => scanLine?.classList.add('scanning'), 650);
    setTimeout(() => {
      receiptSection?.classList.add('shifted');
      parsed?.classList.add('visible');
    }, 2100);
    setTimeout(() => metadata?.classList.add('visible'), 2450);
    setTimeout(() => {
      Object.entries(receiptData).forEach(([key, value]) => {
        if (key === 'items') return;
        const el = root.querySelector(`[data-value="${key}"]`);
        if (el) el.textContent = value;
      });
    }, 2750);
    setTimeout(() => {
      itemsCard?.classList.add('visible');
      receiptData.items.forEach(([name, price, category], index) => {
        setTimeout(() => {
          const row = document.createElement('div');
          row.className = 'parsed-item';
          row.innerHTML = `<span>${name}</span><em>${category}</em><strong>${price}</strong>`;
          list?.appendChild(row);
          requestAnimationFrame(() => row.classList.add('visible'));
        }, index * 140);
      });
    }, 3100);
  }

  document.querySelectorAll('[data-receipt-demo]').forEach((root) => {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) runReceiptDemo(root);
    }, { threshold: 0.3 });
    observer.observe(root);
  });
</script>

