---
const rows = [
  ['Burrata', '$14.00', 'EQUAL', '$3.50', '$3.50', '$3.50', '$3.50'],
  ['Latte', '$5.75', 'EXACT', '$2.88', '$2.87', '$0.00', '$0.00'],
  ['Pizza', '$18.00', 'PERCENTAGE', '$9.00', '$0.00', '$4.50', '$4.50'],
  ['Tiramisu', '$9.50', 'SHARES', '$4.75', '$0.00', '$4.75', '$0.00'],
  ['Service fee', '$3.00', 'ADJUSTED', '$1.20', '$0.60', '$0.60', '$0.60'],
];
---

<div class="mt-10 overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950">
  <table class="min-w-[820px] w-full text-left text-sm">
    <thead class="bg-slate-900 font-mono text-xs uppercase text-slate-400">
      <tr>
        <th class="px-4 py-4">BillItem.name</th>
        <th class="px-4 py-4">BillItem.price</th>
        <th class="px-4 py-4">split_type</th>
        <th class="px-4 py-4">Naman</th>
        <th class="px-4 py-4">Chetan</th>
        <th class="px-4 py-4">Adi</th>
        <th class="px-4 py-4">Prachi</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800 font-mono">
      {rows.map((row) => (
        <tr class="hover:bg-slate-900/70">
          {row.map((cell, index) => (
            <td class={`px-4 py-4 ${index === 2 ? 'text-brand-100' : 'text-slate-200'}`}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
