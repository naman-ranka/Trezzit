---
import ReceiptHeroPreview from './preview/ReceiptHeroPreview.astro';
---

<section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[1.05fr_0.95fr] md:items-center md:py-24">
  <div>
    <p class="mb-5 font-mono text-xs uppercase tracking-widest text-slate-400">
      Ledger-First direction
    </p>
    <h1 class="max-w-4xl text-4xl font-medium tracking-[-0.03em] text-white md:text-6xl">
      Your money app should know which items were yours.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
      Trezzit stores every receipt as <code class="font-mono text-brand-100">BillItem</code> rows and every person's portion as
      <code class="font-mono text-brand-100">ItemShare.share_amount</code>, so splitting, budgeting, categories, and AI answers all use the same item-level truth.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="primary-cta rounded-full bg-brand-500 px-6 py-3 text-center font-medium text-white hover:bg-brand-600" href="https://app.trezzit.com/try-receipt">Try the receipt scanner</a>
      <a class="rounded-full border border-white/10 bg-white/[0.04] px-6 py-3 text-center font-medium text-slate-200 hover:bg-white/[0.07]" href="/ledger">See the ledger model</a>
    </div>
  </div>
  <ReceiptHeroPreview />
</section>
