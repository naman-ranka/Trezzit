---
const items = [
  { name: 'Organic Bananas', price: '$3.45', people: ['N', 'C', 'P'] },
  { name: 'Whole Milk Gallon', price: '$3.89', people: ['N', 'C', 'A', 'P'] },
  { name: 'Tide Laundry Pods', price: '$12.97', people: ['N', 'C'] },
  { name: 'Motor Oil 5W-30', price: '$24.88', people: ['N'] },
  { name: 'Nike T-Shirt', price: '$19.99', people: ['A'] },
  { name: 'Ibuprofen 200MG', price: '$8.47', people: ['N', 'P'] },
];

const totals = [
  ['Naman', '$36.41', 'N'],
  ['Chetan', '$6.77', 'C'],
  ['Adi', '$20.96', 'A'],
  ['Prachi', '$13.18', 'P'],
];

const avatarClass: Record<string, string> = {
  N: 'bg-[#4F46E5]',
  C: 'bg-[#8b5cf6]',
  A: 'bg-[#06b6d4]',
  P: 'bg-[#10b981]',
};
---

<section class="hero-ledger relative isolate min-h-[70vh] overflow-hidden border-b border-slate-800 bg-slate-950 md:min-h-[85vh]">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,rgba(79,70,229,0.24),transparent_38rem)]"></div>
  <div class="section-shell flex min-h-[70vh] flex-col items-center justify-center py-16 text-center md:min-h-[85vh] md:py-24">
    <div class="reveal max-w-4xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-medium text-brand-300">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span>
        The itemized expense ledger
      </span>
      <h1 class="mt-7 text-balance text-6xl font-black leading-[0.95] tracking-tighter text-slate-50 md:text-7xl lg:text-8xl">
        Every item has a ledger.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl font-light leading-relaxed text-slate-400 md:text-2xl">
        Split bills by line, person, and proof.
      </p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="https://app.trezzit.com/signup" class="rounded-xl bg-brand-500 px-8 py-4 font-semibold text-white shadow-[0_0_30px_-5px_rgba(79,70,229,0.4)] transition-all duration-150 ease-out hover:bg-brand-400">Sign up free</a>
        <a href="https://app.trezzit.com/try-receipt" class="rounded-xl border border-slate-700 px-8 py-4 font-medium text-slate-300 transition-all duration-150 ease-out hover:border-slate-500 hover:text-white">Try receipt demo</a>
      </div>
    </div>

    <div class="hero-before-after reveal mt-14 grid w-full max-w-6xl items-center gap-5 lg:grid-cols-[1fr_90px_1.2fr]">
      <figure class="receipt-paper relative rounded-lg border border-slate-700 bg-[#f8f5ee] p-6 text-left font-mono text-sm text-slate-900 shadow-2xl">
        <figcaption class="text-center text-xs font-bold tracking-[0.2em]">WALMART SUPERCENTER</figcaption>
        <p class="mt-1 text-center text-[10px] uppercase tracking-wide text-slate-600">1849 W Bell Rd / Phoenix AZ</p>
        <div class="my-4 border-t border-dashed border-slate-400"></div>
        <div class="space-y-2">
          {items.map((item) => (
            <div class="flex justify-between gap-4"><span>{item.name}</span><span>{item.price}</span></div>
          ))}
        </div>
        <div class="my-4 border-t border-dashed border-slate-400"></div>
        <div class="space-y-1">
          <div class="flex justify-between"><span>SUBTOTAL</span><span>$73.65</span></div>
          <div class="flex justify-between"><span>TAX</span><span>$3.67</span></div>
          <div class="flex justify-between text-base font-bold"><span>TOTAL</span><span>$77.32</span></div>
        </div>
      </figure>

      <div class="connector hidden flex-col items-center justify-center text-brand-300 lg:flex">
        <svg width="88" height="42" viewBox="0 0 88 42" fill="none" aria-hidden="true">
          <path class="connector-line" d="M4 22 C24 2 56 2 84 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M77 13 L84 21 L73 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="mt-2 text-center font-mono text-[10px] uppercase tracking-wider">AI parses + you assign</span>
      </div>

      <div class="ledger-card overflow-hidden rounded-2xl border border-slate-700 bg-slate-900/95 p-5 text-left shadow-2xl shadow-indigo-500/10">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
          <span class="rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 font-mono text-[11px] uppercase tracking-wider text-brand-300">ITEMIZED LEDGER / 6 items / 4 people</span>
          <span class="money text-sm text-slate-400">$77.32</span>
        </div>
        <div class="mt-4 divide-y divide-slate-800">
          {items.map((item, index) => (
            <div class="ledger-row grid grid-cols-[1fr_auto_auto] items-center gap-3 py-3" style={`--d:${index * 60}ms`}>
              <span class="min-w-0 truncate text-sm font-medium text-slate-200">{item.name}</span>
              <span class="money text-sm text-slate-300">{item.price}</span>
              <span class="flex -space-x-1">
                {item.people.map((person) => <span class={`grid h-6 w-6 place-items-center rounded-full ring-2 ring-slate-900 ${avatarClass[person]}`}><span class="text-[10px] font-bold text-white">{person}</span></span>)}
              </span>
            </div>
          ))}
        </div>
        <div class="balance-card mt-5 grid gap-3 rounded-xl border border-slate-700 bg-slate-950/70 p-4 sm:grid-cols-4">
          {totals.map(([name, amount, initial]) => (
            <div>
              <div class="flex items-center gap-2">
                <span class={`grid h-6 w-6 place-items-center rounded-full text-[10px] font-bold text-white ${avatarClass[initial]}`}>{initial}</span>
                <span class="text-xs text-slate-400">{name}</span>
              </div>
              <p class="money mt-2 text-sm font-semibold text-slate-50">{amount}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-ledger .inline-flex .bg-brand-500 {
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  .receipt-paper {
    transform: rotate(-1.5deg);
  }

  .hero-before-after.in-view .receipt-paper {
    animation: receipt-in 900ms ease both;
  }

  @supports (animation-timeline: view()) {
    .hero-before-after .receipt-paper {
      animation: receipt-in 900ms ease both;
      animation-timeline: view();
      animation-range: entry 15% cover 30%;
    }
  }

  .connector-line {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
  }

  .hero-before-after.in-view .connector-line,
  .hero-before-after:hover .connector-line {
    animation: draw-line 650ms ease 450ms forwards;
  }

  .ledger-row,
  .balance-card {
    opacity: 0;
    transform: translateY(10px);
  }

  .hero-before-after.in-view .ledger-row,
  .hero-before-after:hover .ledger-row {
    animation: row-in 450ms ease calc(700ms + var(--d)) forwards;
  }

  .hero-before-after.in-view .balance-card,
  .hero-before-after:hover .balance-card {
    animation: row-in 500ms ease 1150ms forwards;
  }

  @keyframes pulse-dot {
    50% { box-shadow: 0 0 0 6px rgba(79, 70, 229, 0.18); }
  }

  @keyframes receipt-in {
    from { opacity: 0; transform: rotate(-1.5deg) scale(0.96); }
    to { opacity: 1; transform: rotate(-1.5deg) scale(1); }
  }

  @keyframes draw-line {
    to { stroke-dashoffset: 0; }
  }

  @keyframes row-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .connector-line { stroke-dashoffset: 0; }
    .ledger-row,
    .balance-card { opacity: 1; transform: none; }
  }
</style>
