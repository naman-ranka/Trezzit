---
const rows = [
  ['Paneer tacos', '$18.20', 'Maya, You'],
  ['Garlic fries', '$9.50', 'Aarav'],
  ['Tax + tip', '$7.84', 'Follows items'],
];
---

<section class="border-t border-white/10 px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold text-brand-300">Tap Who Had What</p>
      <h2 class="mt-3 text-3xl font-bold text-white">Split by item instead of arguing over the total.</h2>
      <ul class="mt-5 space-y-2 text-slate-300">
        <li>Use Equal, Percent, Exact, or Shares in the app.</li>
        <li>Tax and tip follow the items.</li>
        <li>Everyone sees a clean balance.</li>
      </ul>
    </div>
    <div class="rounded-lg border border-white/10 bg-slate-950 p-4">
      <div class="grid grid-cols-[1fr_auto_1fr] gap-3 border-b border-white/10 pb-3 text-xs uppercase text-slate-500">
        <span>Item</span><span>Amount</span><span>People</span>
      </div>
      {rows.map(([item, amount, people]) => (
        <div class="grid grid-cols-[1fr_auto_1fr] gap-3 border-b border-white/10 py-3 text-sm last:border-0">
          <span class="text-white">{item}</span>
          <span class="font-mono text-brand-300">{amount}</span>
          <span class="text-slate-300">{people}</span>
        </div>
      ))}
    </div>
  </div>
</section>
