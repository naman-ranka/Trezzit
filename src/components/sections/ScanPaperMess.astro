---
const steps = [
  ['01', 'Upload', 'JPEG, PNG, WebP, or PDF. Camera works on mobile.', 'M4 16v2a2 2 0 0 0 2-2h2v-2H6a2 2 0 0 0-2 2Zm8-12v10m0-10 4 4m-4-4-4 4'],
  ['02', 'Review', 'Gemini extracts every line. You confirm or edit before saving.', 'M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'],
  ['03', 'Items', 'Items become editable rows ready to split.', 'M4 5h16M4 12h16M4 19h16M8 5v14m8-14v14'],
];

const items = [
  ['Organic Bananas', '$3.45'],
  ['Whole Milk Gallon', '$3.89'],
  ['Tide Laundry Pods', '$12.97'],
  ['Motor Oil 5W-30', '$24.88'],
  ['Nike T-Shirt', '$19.99'],
  ['Ibuprofen 200MG', '$8.47'],
];
---

<section class="reveal-section border-t border-slate-800 px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.16em] text-brand-300">02 · Receipt scanning</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl">Receipt to itemized in seconds.</h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {steps.map(([num, title, copy, icon]) => (
        <article class="rounded-2xl border border-slate-700 bg-slate-800/40 p-6 transition-transform hover:-translate-y-1">
          <div class="flex items-center justify-between">
            <p class="font-mono text-sm text-brand-300">{num}</p>
            <svg class="h-6 w-6 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icon}></path>
            </svg>
          </div>
          <h3 class="mt-5 text-xl font-semibold text-slate-100">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-400">{copy}</p>
        </article>
      ))}
    </div>

    <div class="receipt-demo mt-8 rounded-3xl border border-slate-700 bg-slate-950/70 p-4 shadow-xl shadow-indigo-500/10">
      <div class="grid gap-4 lg:grid-cols-[0.78fr_1.22fr] lg:items-stretch">
        <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 p-5">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(79,70,229,0.22),transparent_42%)]"></div>
          <div class="scan-line" aria-hidden="true"></div>
          <div class="relative rounded-2xl bg-slate-100 p-5 font-mono text-xs text-slate-950 shadow-2xl">
            <p class="text-center text-[11px] font-bold uppercase tracking-[0.18em] text-slate-500">Walmart Supercenter</p>
            <p class="mt-2 text-center text-[10px] text-slate-500">July 24, 2025</p>
            <div class="mt-4 space-y-2">
              {items.map(([name, price]) => <div class="flex justify-between gap-4"><span>{name}</span><span>{price}</span></div>)}
            </div>
            <div class="mt-4 border-t border-dashed border-slate-300 pt-3">
              <div class="flex justify-between"><span>Tax</span><span>$3.67</span></div>
              <div class="mt-1 flex justify-between text-sm font-bold"><span>Total</span><span>$77.32</span></div>
            </div>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-[0.72fr_1fr]">
          <div class="grid gap-3">
            {[
              ['Merchant', 'Walmart Supercenter'],
              ['Date', 'July 24, 2025'],
              ['Total', '$77.32'],
              ['Tax', '$3.67'],
            ].map(([label, value], index) => (
              <div class="data-card rounded-2xl border border-slate-700 bg-slate-900 p-4" style={`--i:${index}`}>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">{label}</p>
                <p class="mt-2 font-mono text-sm text-slate-100">{value}</p>
              </div>
            ))}
          </div>
          <div class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-300">Review rows</p>
                <h3 class="mt-1 font-semibold text-slate-100">Editable before saving</h3>
              </div>
              <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs text-emerald-300">6 items</span>
            </div>
            <div class="mt-4 space-y-2">
              {items.map(([name, price], index) => (
                <div class="item-row flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-slate-950/70 px-3 py-2" style={`--i:${index}`}>
                  <span class="truncate text-sm text-slate-200">{name}</span>
                  <span class="font-mono text-sm text-brand-300">{price}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .scan-line {
    position: absolute;
    inset-inline: 20px;
    top: 0;
    z-index: 2;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(129, 140, 248, 0.95), transparent);
    box-shadow: 0 0 24px rgba(79, 70, 229, 0.8);
    animation: scan-card 3.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  .data-card,
  .item-row {
    opacity: 0;
    transform: translateY(12px);
    animation: pop-in 620ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(400ms + var(--i) * 110ms);
  }

  .item-row {
    animation-delay: calc(900ms + var(--i) * 95ms);
  }

  @keyframes scan-card {
    0%, 14% { transform: translateY(0); opacity: 0; }
    24% { opacity: 1; }
    76% { opacity: 1; }
    100% { transform: translateY(430px); opacity: 0; }
  }

  @keyframes pop-in {
    70% { transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-line,
    .data-card,
    .item-row {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
