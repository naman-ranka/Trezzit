---
const steps = [
  ['01', 'Upload', 'Upload or capture JPEG, PNG, WebP, or PDF receipts.'],
  ['02', 'Review', 'Gemini extracts line items, tax, discount, merchant, date, and warnings.'],
  ['03', 'Items', 'Review before saving; items become editable rows.'],
];
---

<section class="border-t border-white/10 px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.9fr_1fr]">
    <div>
      <p class="text-sm font-semibold text-brand-300">Scan the Paper Mess</p>
      <h2 class="mt-3 text-3xl font-bold text-white">From paper receipt to editable items.</h2>
      <div class="mt-8 grid gap-4">
        {steps.map(([num, title, copy]) => (
          <div class="rounded-lg border border-white/10 bg-slate-950 p-4">
            <p class="font-mono text-sm text-brand-300">{num}</p>
            <h3 class="mt-2 font-semibold text-white">{title}</h3>
            <p class="mt-1 text-sm text-slate-300">{copy}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="rounded-lg border border-dashed border-white/20 bg-slate-950 p-6 text-sm text-slate-400">
      <div class="aspect-[4/3] rounded-md bg-slate-900 p-4">[placeholder for screenshot: receipt review sheet]</div>
    </div>
  </div>
</section>
