---
const demos = [
  {
    title: 'Receipt demo',
    href: 'https://app.trezzit.com/try-receipt',
    bullets: ['Runs without login using pre-scanned demo data.', 'Shows item assignment before anyone creates an account.'],
  },
  {
    title: 'Bill calculator',
    href: 'https://app.trezzit.com/demo',
    bullets: ['Runs without login and does not persist data.', 'Signup saves real groups and real receipt processing.'],
  },
];
---

<section class="border-t border-white/10 px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <p class="text-sm font-semibold text-brand-300">Try It Before Signup</p>
    <h2 class="mt-3 text-3xl font-bold text-white">Two demos before the form.</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {demos.map((demo) => (
        <article class="rounded-lg border border-white/10 bg-slate-950 p-6">
          <div class="aspect-video rounded-md border border-dashed border-white/20 bg-slate-900 p-4 text-sm text-slate-400">[placeholder for screenshot]</div>
          <h3 class="mt-5 text-xl font-semibold text-white">{demo.title}</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-300">
            {demo.bullets.map((bullet) => <li>{bullet}</li>)}
            <li>No credit card required.</li>
          </ul>
          <a class="mt-5 inline-flex rounded-md bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-600" href={demo.href}>Open {demo.title}</a>
        </article>
      ))}
    </div>
  </div>
</section>
