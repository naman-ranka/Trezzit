---
const demos = [
  {
    title: 'Receipt scan demo',
    href: 'https://app.trezzit.com/try-receipt',
    cta: 'Open demo →',
    body: "Pre-scanned restaurant receipt. Tap items to split between 3 people. See how it'd work with your group.",
    note: 'Demo data only — not real OCR',
    type: 'receipt',
  },
  {
    title: 'Bill calculator',
    href: 'https://app.trezzit.com/demo',
    cta: 'Open calculator →',
    body: 'Split any bill any way: equal, percent, exact, shares. Real math. No saving.',
    note: 'Calculator only — nothing saved',
    type: 'calculator',
  },
];
---

<section class="reveal-section border-t border-slate-800 px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.16em] text-brand-300">01 · No login required</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl">Two ways to try Trezzit right now.</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-400">
        Both work without an account. Neither saves anything. Use them, decide, then signup if you like what you see.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {demos.map((demo) => (
        <article class="group rounded-2xl border border-slate-700 bg-slate-800/40 p-8 transition-all hover:scale-[1.02] hover:border-brand-500/50 hover:bg-slate-800/70 hover:shadow-xl hover:shadow-indigo-500/10">
          <div class="overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 p-4">
            {demo.type === 'receipt' ? (
              <div class="grid grid-cols-[0.72fr_1fr] gap-3">
                <div class="rounded-xl bg-slate-100 p-3 font-mono text-[10px] leading-5 text-slate-900 shadow-lg">
                  <p class="text-center font-bold">JOE'S TABLE</p>
                  <div class="mt-2 border-t border-dashed border-slate-300 pt-2">
                    <div class="flex justify-between"><span>Tacos</span><span>18.20</span></div>
                    <div class="flex justify-between"><span>Fries</span><span>9.50</span></div>
                    <div class="flex justify-between"><span>Salad</span><span>12.00</span></div>
                    <div class="mt-2 flex justify-between border-t border-dashed border-slate-300 pt-2 font-bold"><span>Total</span><span>47.36</span></div>
                  </div>
                </div>
                <div class="space-y-2">
                  {['Paneer tacos', 'Garlic fries', 'House salad'].map((item, index) => (
                    <div class="rounded-xl border border-slate-800 bg-slate-900 px-3 py-2">
                      <p class="text-xs font-medium text-slate-200">{item}</p>
                      <div class="mt-2 flex -space-x-1.5">
                        {['Y', 'A', 'M'].slice(0, index + 1).map((initial) => <span class="grid h-6 w-6 place-items-center rounded-full border border-slate-950 bg-brand-500 text-[10px] font-bold text-white">{initial}</span>)}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div class="space-y-3">
                <div class="grid grid-cols-4 gap-2 rounded-xl border border-slate-800 bg-slate-900 p-2 text-center text-[11px] font-medium text-slate-400">
                  {['Equal', 'Percent', 'Exact', 'Shares'].map((mode, index) => <span class={index === 0 ? 'rounded-lg bg-brand-500 px-2 py-1 text-white' : 'px-2 py-1'}>{mode}</span>)}
                </div>
                {[
                  ['Dinner total', '$86.40'],
                  ['Tax + tip', '$19.01'],
                  ['Maya owes', '$28.47'],
                ].map(([label, amount]) => (
                  <div class="flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900 px-4 py-3">
                    <span class="text-sm text-slate-300">{label}</span>
                    <span class="font-mono text-sm font-semibold text-brand-300">{amount}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
          <h3 class="mt-6 text-2xl font-semibold tracking-tight text-slate-100">{demo.title}</h3>
          <p class="mt-3 min-h-20 text-slate-400">{demo.body}</p>
          <p class="mt-4 text-sm text-slate-500">{demo.note}</p>
          <a class="mt-6 inline-flex min-h-11 items-center rounded-xl border border-brand-500/40 px-4 py-2 text-sm font-semibold text-brand-200 transition-colors group-hover:bg-brand-500 group-hover:text-white" href={demo.href}>
            {demo.cta}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
