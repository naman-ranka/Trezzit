---
const bullets = [
  '13 MCP tools over JSON-RPC 2.0.',
  '9 read tools, 3 write tools, 1 receipt-upload helper.',
  'OAuth 2.1 with Claude, Cursor, ChatGPT, Gemini, and other MCP-aware clients.',
  'Write tools are rate-limited; destructive delete is constrained.',
];
---

<section class="border-b border-white/10 bg-slate-950">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div class="aspect-[16/10] rounded-xl border border-dashed border-brand-300/40 bg-slate-800 p-6 font-mono text-sm text-brand-300">[placeholder for screenshot]</div>
    <div>
      <p class="font-mono text-sm text-brand-300">06 / AI</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">AI Can Query the Same Ledger</h2>
      <ul class="mt-6 list-inside list-disc space-y-3 text-slate-300">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <a href="/ai" class="mt-6 inline-flex rounded-lg border border-brand-300/40 px-4 py-2 text-sm font-medium text-brand-300 hover:bg-brand-500 hover:text-white">Open the AI page</a>
    </div>
  </div>
</section>
