---
const clients = ['Claude', 'Cursor', 'ChatGPT', 'Gemini'];
const readTools = ['get_balances', 'get_context', 'search_bills', 'list_groups', 'get_group_details', 'resolve_participants', 'get_bill_details', 'get_expenses', 'get_person_info'];
const writeTools = ['create_bill', 'create_settlement', 'get_receipt_upload_presigned_url'];
const destructiveTools = ['delete_bill'];
const config = `{
  "mcpServers": {
    "trezzit": {
      "command": "npx",
      "args": ["mcp-remote", "https://api.trezzit.com/api/mcp"],
      "auth": { "type": "oauth2-pkce" }
    }
  }
}`;

const toolGroups = [
  { title: 'READ', tools: readTools, amber: false },
  { title: 'WRITE', tools: writeTools, amber: false },
  { title: 'DESTRUCTIVE', tools: destructiveTools, amber: true },
];
---

<section class="border-b border-slate-800 bg-slate-950 py-16 md:py-24">
  <div class="section-shell rounded-3xl border border-slate-800 bg-slate-800/50 p-6 shadow-lg shadow-indigo-500/10 md:p-10">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">06 / MCP + your agent</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-50 md:text-5xl">Your agent already speaks Trezzit.</h2>
      <p class="mt-6 text-lg leading-relaxed text-slate-400">13 MCP tools over JSON-RPC 2.0 - connect Claude, Cursor, ChatGPT, or Gemini with OAuth 2.1 and item-level read/write access.</p>
    </div>

    <div class="reveal mt-8 flex flex-wrap items-center gap-4 border-y border-slate-700/70 py-4">
      <span class="text-xs uppercase tracking-wider text-slate-500">Works with</span>
      {clients.map((client) => <span class="text-sm font-semibold text-slate-300 opacity-60">{client}</span>)}
    </div>

    <div class="reveal mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-slate-700 bg-slate-950 p-5">
        <p class="font-mono text-[11px] uppercase tracking-wider text-brand-300">agent replay</p>
        <div class="mt-4 space-y-3 font-mono text-sm">
          <p class="rounded-lg bg-slate-900 p-3 text-slate-300">user: "How much did Maya owe from the cabin trip?"</p>
          <p class="rounded-lg bg-slate-900 p-3 text-brand-300">-&gt; called get_balances(&#123;group: "Cabin trip"&#125;)</p>
          <p class="rounded-lg bg-slate-900 p-3 text-slate-100">&lt;- Maya owes $18.20</p>
        </div>
      </div>
      <div class="rounded-2xl border border-slate-700 bg-slate-950 p-5">
        <div class="flex items-center justify-between">
          <p class="font-mono text-[11px] uppercase tracking-wider text-brand-300">Claude Desktop config</p>
          <span class="text-xs text-slate-500">OAuth 2.1 + PKCE</span>
        </div>
        <pre class="mt-4 overflow-x-auto rounded-xl bg-slate-900 p-4 text-sm leading-relaxed text-slate-200"><code>{config}</code></pre>
      </div>
    </div>

    <div id="tools" class="reveal mt-6 grid gap-4 md:grid-cols-3">
      {toolGroups.map((group) => (
        <article class={`rounded-2xl border ${group.amber ? 'border-amber-500/30' : 'border-slate-700'} bg-slate-950 p-5`}>
          <h3 class={`font-mono text-xs font-semibold tracking-wider ${group.amber ? 'text-amber-300' : 'text-brand-300'}`}>{group.title}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.tools.map((tool) => <span class="rounded-lg border border-slate-800 bg-slate-900 px-2 py-1 font-mono text-[11px] text-slate-300">{tool}</span>)}
          </div>
        </article>
      ))}
    </div>

    <p class="reveal mt-6 text-sm text-slate-400">Standard OAuth 2.1 with PKCE. No API keys. <a href="/ai" class="font-medium text-brand-300 hover:text-brand-200">Open the full AI page</a>.</p>
  </div>
</section>
