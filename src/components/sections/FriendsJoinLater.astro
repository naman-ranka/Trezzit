---
const cards = [
  ['Maya joined', '2 min ago', 'check', 'rotate-[-2deg] md:translate-y-5'],
  ['Aarav claimed 4 bills', '$32.50 transferred', 'transfer', 'rotate-1'],
  ['Chetan owes $18.20 from cabin trip', 'last week', 'amount', 'rotate-[-1deg]'],
  ['Invite link copied — share via iMessage', 'just now', 'link', 'rotate-2 md:-translate-y-4'],
];
---

<section class="reveal-section border-t border-slate-800 px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.88fr_1fr] lg:items-center">
    <div>
      <p class="font-mono text-sm font-semibold uppercase tracking-[0.16em] text-brand-300">04 · Placeholder users</p>
      <h2 class="mt-3 text-4xl font-bold tracking-tight text-slate-100 md:text-5xl">Add friends without asking.</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-400">
        Type their name. They appear in the group. They can join later — or never. Either way, your splits stay accurate.
      </p>
    </div>

    <div>
      <div class="grid gap-4 sm:grid-cols-2">
        {cards.map(([title, meta, icon, transform]) => (
          <article class:list={['rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg shadow-black/20 transition-transform hover:-translate-y-1', transform]}>
            <div class="flex items-start gap-3">
              <span class:list={[
                'grid h-9 w-9 shrink-0 place-items-center rounded-full border',
                icon === 'check' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300' : icon === 'transfer' ? 'border-brand-500/30 bg-brand-500/10 text-brand-300' : 'border-slate-600 bg-slate-900 text-slate-300',
              ]}>
                {icon === 'check' ? '✓' : icon === 'transfer' ? '↗' : icon === 'link' ? '⛓' : '$'}
              </span>
              <div>
                <h3 class="font-semibold text-slate-100">{title}</h3>
                <p class="mt-1 font-mono text-xs text-slate-500">{meta}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-8 rounded-2xl border border-slate-700 bg-slate-950 p-5 shadow-xl shadow-indigo-500/10">
        <p class="text-sm leading-6 text-slate-300">
          <span class="font-semibold text-slate-100">"Aarav"</span> has <span class="font-mono text-brand-300">4 bills</span> and <span class="font-mono text-brand-300">2 payments</span> where you're owed <span class="font-mono text-emerald-300">$32.50</span>. Joining moves them to your account.
        </p>
      </div>
    </div>
  </div>
</section>
