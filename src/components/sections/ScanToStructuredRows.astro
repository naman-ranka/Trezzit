---
const bullets = [
  'JPEG, PNG, WebP, and PDF uploads are supported.',
  'Two-pass Google Gemini pipeline extracts items, totals, tax, discounts, and warnings.',
  'Re-uploaded receipt images are cached by SHA-256 hash.',
  'Review sheet surfaces mismatches before saving.',
];
---

<section id="receipts" class="border-b border-white/10 bg-slate-950">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div class="aspect-[16/10] rounded-xl border border-dashed border-brand-300/40 bg-slate-800 p-6 font-mono text-sm text-brand-300">[placeholder for screenshot]</div>
    <div>
      <p class="font-mono text-sm text-brand-300">02 / Receipts</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">Scan to Structured Rows</h2>
      <ul class="mt-6 list-inside list-disc space-y-3 text-slate-300">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>
  </div>
</section>
