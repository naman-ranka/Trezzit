---
const bullets = [
  'Import Splitwise CSVs through a five-step wizard.',
  'Upload, create or choose a fresh group, map yourself, map people, import.',
  'Placeholder users cover friends without accounts.',
  'Server checks final balances within one cent.',
];
---

<section id="imports" class="border-b border-white/10 bg-slate-950">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div class="aspect-[16/10] rounded-xl border border-dashed border-brand-300/40 bg-slate-800 p-6 font-mono text-sm text-brand-300">[placeholder for screenshot]</div>
    <div>
      <p class="font-mono text-sm text-brand-300">04 / Import</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">Bring Your History</h2>
      <ul class="mt-6 list-inside list-disc space-y-3 text-slate-300">
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
      <p class="mt-5 text-sm text-slate-500">Honest constraint: Splitwise CSV import targets a fresh group with zero existing bills or payments.</p>
    </div>
  </div>
</section>
