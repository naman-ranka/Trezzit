---
const included = ['Itemized groups and bills', 'Receipt scanning for signed-in users', 'Splitwise CSV import', 'Public receipt demo and bill calculator', 'MCP access within platform rate limits'];
---

<section class="bg-slate-900 py-16 md:py-24">
  <div class="section-shell text-center">
    <div class="reveal mx-auto max-w-3xl">
      <p class="eyebrow">Pricing today</p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight text-slate-50 md:text-5xl">Free, forever - for now.</h2>
      <p class="mt-5 text-lg text-slate-400">No credit card. No quotas. No upsell path yet.</p>
    </div>
    <div class="reveal mx-auto mt-10 max-w-md rounded-2xl border border-slate-700 bg-slate-800/50 p-8 text-left shadow-2xl shadow-indigo-500/10">
      <p class="text-sm font-semibold text-brand-300">Free</p>
      <p class="money mt-3 text-4xl font-bold text-slate-50">$0/month</p>
      <ul class="mt-6 space-y-3 text-sm text-slate-300">
        {included.map((item) => <li class="flex gap-3"><span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-brand-400"></span><span>{item}</span></li>)}
      </ul>
      <a href="https://app.trezzit.com/signup" class="mt-8 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-brand-500 px-5 font-semibold text-white transition-colors hover:bg-brand-400">Sign up free</a>
    </div>
    <div class="reveal mt-6 flex flex-col items-center justify-center gap-3 text-sm text-slate-400 sm:flex-row">
      <a href="https://app.trezzit.com/try-receipt" class="hover:text-brand-300">or try the receipt demo</a>
      <span class="hidden text-slate-700 sm:inline">/</span>
      <a href="https://app.trezzit.com/demo" class="hover:text-brand-300">or the bill calculator</a>
    </div>
  </div>
</section>
