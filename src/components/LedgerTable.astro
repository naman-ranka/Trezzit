---
const rows = [
  ['Bill.date', '2026-05-21'],
  ['BillItem.name', 'Latte'],
  ['BillItem.price', '$5.75'],
  ['ItemShare.person', 'Naman'],
  ['ItemShare.share_amount', '$2.88'],
  ['ItemShare.category', 'Food > Coffee'],
  ['category_status', 'AI_SUGGESTED -> CONFIRMED'],
  ['split_type', 'EQUAL'],
];
---

<div class="mt-10 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
  <div class="grid grid-cols-[1fr_1fr] border-b border-slate-800 bg-slate-900 px-4 py-3 font-mono text-xs uppercase text-slate-400">
    <span>Field</span>
    <span>Value</span>
  </div>
  <div class="divide-y divide-slate-800 font-mono text-sm">
    {rows.map(([field, value]) => (
      <div class="grid grid-cols-[1fr_1fr] px-4 py-4">
        <span class="text-slate-400">{field}</span>
        <span class="text-slate-100">{value}</span>
      </div>
    ))}
  </div>
</div>
